[if (arr.booleanSensorVariables.variables->notEmpty())]
[for (v : BooleanVariable in arr.booleanSensorVariables.variables)]
    /\ [v.variableID/]' \in BOOLEAN
[/for]
[/if]
[if (arr.sensorVariables.variables->notEmpty())]
[for (v : IntegerVariable in arr.sensorVariables.variables)]
    /\ [v.variableID/]' \in ([if (v.theLowerBound.oclIsKindOf(IntegerConstant))][if (v.theLowerBound.oclAsType(IntegerConstant).anIntegerValue > 0)][v.theLowerBound.oclAsType(IntegerConstant).anIntegerValue/][else]0[/if][else]0[/if]..[if (v.theUpperBound.oclIsKindOf(IntegerConstant))][if (v.theUpperBound.oclAsType(IntegerConstant).anIntegerValue > 0)][v.theUpperBound.oclAsType(IntegerConstant).anIntegerValue/][else]0[/if][else]0[/if])
[/for]
[/if]

[/let]
[/for]

T[machineID/]Default == /\ sequentialTurn = [machineID/]
    /\ ( ~[sm.name/]State = "__[sm.name/]"
[for (tr : Transition in sm.transitions)]
         /\ ~([sm.name/]State = "[tr.sourceState.stateName/]"[if (tr.booleanExpression.oclIsKindOf(BooleanConstant))][if (tr.booleanExpression.oclAsType(BooleanConstant).aBooleanValue)] /\ TRUE[else] /\ FALSE[/if][elseif (tr.booleanExpression.oclIsKindOf(BooleanVariableReference))] /\ [tr.booleanExpression.oclAsType(BooleanVariableReference).theVariable.variableID/][elseif (tr.booleanExpression.oclIsKindOf(EqualExpression))] /\ ([if (tr.booleanExpression.oclAsType(EqualExpression).leftExpression.oclIsKindOf(PredefinedIntegerConstant))][tr.booleanExpression.oclAsType(EqualExpression).leftExpression.oclAsType(PredefinedIntegerConstant).listedIntegerConstant.Identifier/][elseif (tr.booleanExpression.oclAsType(EqualExpression).leftExpression.oclIsKindOf(IntegerVariableReference))][if (sm.localVariables.variables->exists(v | v.variableID = tr.booleanExpression.oclAsType(EqualExpression).leftExpression.oclAsType(IntegerVariableReference).theVariable.variableID))][sm.name/]_[/if][tr.booleanExpression.oclAsType(EqualExpression).leftExpression.oclAsType(IntegerVariableReference).theVariable.variableID/][/if] = [if (tr.booleanExpression.oclAsType(EqualExpression).rightExpression.oclIsKindOf(PredefinedIntegerConstant))][tr.booleanExpression.oclAsType(EqualExpression).rightExpression.oclAsType(PredefinedIntegerConstant).listedIntegerConstant.Identifier/][elseif (tr.booleanExpression.oclAsType(EqualExpression).rightExpression.oclIsKindOf(IntegerVariableReference))][if (sm.localVariables.variables->exists(v | v.variableID = tr.booleanExpression.oclAsType(EqualExpression).rightExpression.oclAsType(IntegerVariableReference).theVariable.variableID))][sm.name/]_[/if][tr.booleanExpression.oclAsType(EqualExpression).rightExpression.oclAsType(IntegerVariableReference).theVariable.variableID/][/if])[elseif (tr.booleanExpression.oclIsKindOf(NotExpression))] /\ ( ~([if (tr.booleanExpression.oclAsType(NotExpression).theExpression.oclIsKindOf(EqualExpression))][if (tr.booleanExpression.oclAsType(NotExpression).theExpression.oclAsType(EqualExpression).leftExpression.oclIsKindOf(IntegerVariableReference))][if (sm.localVariables.variables->exists(v | v.variableID = tr.booleanExpression.oclAsType(NotExpression).theExpression.oclAsType(EqualExpression).leftExpression.oclAsType(IntegerVariableReference).theVariable.variableID))][sm.name/]_[/if][tr.booleanExpression.oclAsType(NotExpression).theExpression.oclAsType(EqualExpression).leftExpression.oclAsType(IntegerVariableReference).theVariable.variableID/][/if] = [if (tr.booleanExpression.oclAsType(NotExpression).theExpression.oclAsType(EqualExpression).rightExpression.oclIsKindOf(IntegerVariableReference))][if (sm.localVariables.variables->exists(v | v.variableID = tr.booleanExpression.oclAsType(NotExpression).theExpression.oclAsType(EqualExpression).rightExpression.oclAsType(IntegerVariableReference).theVariable.variableID))][sm.name/]_[/if][tr.booleanExpression.oclAsType(NotExpression).theExpression.oclAsType(EqualExpression).rightExpression.oclAsType(IntegerVariableReference).theVariable.variableID/][/if][/if]))[/if])
[/for]
        )
    /\ UNCHANGED<<[sm.name/]State>>
[if (arr.stateMachine->size() > 1)]
    /\ UNCHANGED<<[for (other : StateMachine in arr.stateMachine->reject(m | m.name = sm.name)) separator(', ')][other.name/]State[/for]>>
[/if]
[for (other : StateMachine in arr.stateMachine)]
[if (other.localVariables.variables->notEmpty())]
    /\ UNCHANGED<<[for (v : IntegerVariable in other.localVariables.variables) separator(', ')][other.name/]_[v.variableID/][/for]>>
[/if]
[/for]
[if (arr.whiteboardVariables.variables->notEmpty())]
    /\ UNCHANGED<<[for (v : IntegerVariable in arr.whiteboardVariables.variables) separator(', ')][v.variableID/][/for]>>
[/if]
[if (arr.booleanSensorVariables.variables->notEmpty())]
[for (v : BooleanVariable in arr.booleanSensorVariables.variables)]
    /\ [v.variableID/]' \in BOOLEAN
[/for]
[/if]
[if (arr.sensorVariables.variables->notEmpty())]
[for (v : IntegerVariable in arr.sensorVariables.variables)]
    /\ [v.variableID/]' \in ([if (v.theLowerBound.oclIsKindOf(IntegerConstant))][if (v.theLowerBound.oclAsType(IntegerConstant).anIntegerValue > 0)][v.theLowerBound.oclAsType(IntegerConstant).anIntegerValue/][else]0[/if][else]0[/if]..[if (v.theUpperBound.oclIsKindOf(IntegerConstant))][if (v.theUpperBound.oclAsType(IntegerConstant).anIntegerValue > 0)][v.theUpperBound.oclAsType(IntegerConstant).anIntegerValue/][else]0[/if][else]0[/if])
[/for]
[/if]

[/let]
[/for]

(***************************************************************************)
(* Next-state relation                                                     *)
(***************************************************************************)
[arr.arrangementName/]Next ==
(*************************************************************************)
(* A deterministic scheduler advances turns in round robin fashion       *)
(*************************************************************************)
    sequentialTurn' = (sequentialTurn + 1) % [arr.stateMachine->size()/] /\
[for (sm : StateMachine in arr.stateMachine)]
[let machineID : Integer = arr.stateMachine->indexOf(sm)]
(*************************************************************************)
(* The transitions of machine [sm.name/]                                 *)
(*************************************************************************)
    \/ T[machineID/]0
[for (tr : Transition in sm.transitions)]
[let transitionID : Integer = sm.transitions->indexOf(tr) + 1]
    \/ T[machineID/][transitionID/]
[/let]
[/for]
    \/ T[machineID/]Default
[/let]
[/for]

(***************************************************************************)
(* Specification                                                           *)
(***************************************************************************)
Spec[arr.arrangementName/] == [arr.arrangementName/]Init /\ ['[]'/]['['/][arr.arrangementName/]Next[']'/]_vars /\ WF_vars([arr.arrangementName/]Next)

