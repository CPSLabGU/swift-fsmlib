[module llfsm2tla('http://www.example.org/newGITmetamodelwithtypes')]

[template main(arr : Arrangement)]
[file (arr.arrangementName + '.tla', false)]
(***************************************************************************)
(* TLA+ specification generated from LLFSM arrangement [arr.arrangementName/] *)
(***************************************************************************)
--------------------------- MODULE [arr.arrangementName/] ---------------------------
EXTENDS Integers

[if (arr.integerConstantDefinitions.definitionsIntegerConstants->notEmpty())]
CONSTANTS [for (c : GlobalIntegerConstantDefinition in arr.integerConstantDefinitions.definitionsIntegerConstants) separator(', ')][c.Identifier/][/for]

[/if]
VARIABLES
[for (sm : StateMachine in arr.stateMachine) separator(',\n')]
    [sm.name/]State[/for]
[if (arr.booleanSensorVariables.variables->notEmpty())]
,
[for (v : BooleanVariable in arr.booleanSensorVariables.variables) separator(',\n')]
    [v.variableID/][/for]
[/if]
[if (arr.whiteboardVariables.variables->notEmpty())]
,
[for (v : IntegerVariable in arr.whiteboardVariables.variables) separator(',\n')]
    [v.variableID/][/for]
[/if]
[if (arr.sensorVariables.variables->notEmpty())]
,
[for (v : IntegerVariable in arr.sensorVariables.variables) separator(',\n')]
    [v.variableID/][/for]
[/if]
[if (arr.booleanEffectorVariables.variables->notEmpty())]
,
[for (v : BooleanVariable in arr.booleanEffectorVariables.variables) separator(',\n')]
    [v.variableID/][/for]
[/if]
[if (arr.effectorVariables.variables->notEmpty())]
,
[for (v : IntegerVariable in arr.effectorVariables.variables) separator(',\n')]
    [v.variableID/][/for]
[/if]
[if (arr.booleanWhiteboardVariables.variables->notEmpty())]
,
[for (v : BooleanVariable in arr.booleanWhiteboardVariables.variables) separator(',\n')]
    [v.variableID/][/for]
[/if]
[for (sm : StateMachine in arr.stateMachine)]
[if (sm.localVariables.variables->notEmpty())]
,
[for (v : IntegerVariable in sm.localVariables.variables) separator(',\n')]
    [sm.name/]_[v.variableID/][/for]
[/if]
[if (sm.booleanLocalVariables.variables->notEmpty())]
,
[for (v : BooleanVariable in sm.booleanLocalVariables.variables) separator(',\n')]
    [sm.name/]_[v.variableID/][/for]
[/if]
[/for]
,
    sequentialTurn

vars == <<[for (sm : StateMachine in arr.stateMachine) separator(', ')][sm.name/]State[/for][if (arr.booleanSensorVariables.variables->notEmpty())][for (v : BooleanVariable in arr.booleanSensorVariables.variables)], [v.variableID/][/for][/if][if (arr.whiteboardVariables.variables->notEmpty())][for (v : IntegerVariable in arr.whiteboardVariables.variables)], [v.variableID/][/for][/if][if (arr.sensorVariables.variables->notEmpty())][for (v : IntegerVariable in arr.sensorVariables.variables)], [v.variableID/][/for][/if][if (arr.booleanEffectorVariables.variables->notEmpty())][for (v : BooleanVariable in arr.booleanEffectorVariables.variables)], [v.variableID/][/for][/if][if (arr.effectorVariables.variables->notEmpty())][for (v : IntegerVariable in arr.effectorVariables.variables)], [v.variableID/][/for][/if][if (arr.booleanWhiteboardVariables.variables->notEmpty())][for (v : BooleanVariable in arr.booleanWhiteboardVariables.variables)], [v.variableID/][/for][/if][for (sm : StateMachine in arr.stateMachine)][if (sm.localVariables.variables->notEmpty())][for (v : IntegerVariable in sm.localVariables.variables)], [sm.name/]_[v.variableID/][/for][/if][if (sm.booleanLocalVariables.variables->notEmpty())][for (v : BooleanVariable in sm.booleanLocalVariables.variables)], [sm.name/]_[v.variableID/][/for][/if][/for], sequentialTurn>>

(***************************************************************************)
(* Type invariants                                                         *)
(***************************************************************************)
[for (sm : StateMachine in arr.stateMachine)]
[let machineIdx : Integer = arr.stateMachine->indexOf(sm)]
Types[sm.name/]OK == [sm.name/]State \in {"__[sm.name/]", "[sm.initialState.stateName/]"[for (s : State in sm.states)], "[s.stateName/]"[/for]}
[/let]
[/for]
[if (arr.booleanSensorVariables.variables->notEmpty())]
[for (v : BooleanVariable in arr.booleanSensorVariables.variables)]
Types[v.variableID/]OK == [v.variableID/] \in BOOLEAN
[/for]
[/if]
[if (arr.whiteboardVariables.variables->notEmpty())]
[for (v : IntegerVariable in arr.whiteboardVariables.variables)]
Types[v.variableID/]OK == [v.variableID/] \in ([if (v.theLowerBound.oclIsKindOf(IntegerConstant))][if (v.theLowerBound.oclAsType(IntegerConstant).anIntegerValue > 0)][v.theLowerBound.oclAsType(IntegerConstant).anIntegerValue/][else]0[/if][else]0[/if]..[if (v.theUpperBound.oclIsKindOf(IntegerConstant))][if (v.theUpperBound.oclAsType(IntegerConstant).anIntegerValue > 0)][v.theUpperBound.oclAsType(IntegerConstant).anIntegerValue/][else]0[/if][else]0[/if])
[/for]
[/if]
TypesSeqTurnOK == sequentialTurn \in (0..[arr.stateMachine->size()/])

(***************************************************************************)
(* Initial state predicate                                                 *)
(***************************************************************************)
[arr.arrangementName/]Init ==
    /\ sequentialTurn = 0
[for (sm : StateMachine in arr.stateMachine)]
    /\ [sm.name/]State = "__[sm.name/]"
[/for]
[if (arr.booleanSensorVariables.variables->notEmpty())]
[for (v : BooleanVariable in arr.booleanSensorVariables.variables)]
