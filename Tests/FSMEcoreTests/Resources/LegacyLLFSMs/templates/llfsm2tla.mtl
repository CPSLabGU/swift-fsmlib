T[machineID/]0 == /\ sequentialTurn = [machineID/]
    /\ [sm.name/]State = "__[sm.name/]"
    /\ [sm.name/]State' = "[sm.initialState.stateName/]"
[if (sm.initialState.onEntry.statements->notEmpty())]
[for (stmt : Statement in sm.initialState.onEntry.statements)]
