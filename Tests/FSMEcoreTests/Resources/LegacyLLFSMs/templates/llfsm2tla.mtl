[/for]
[/if]
[if (arr.sensorVariables.variables->notEmpty())]
[for (v : IntegerVariable in arr.sensorVariables.variables)]
    /\ [v.variableID/] \in ([if (v.theLowerBound.oclIsKindOf(IntegerConstant))][if (v.theLowerBound.oclAsType(IntegerConstant).anIntegerValue > 0)][v.theLowerBound.oclAsType(IntegerConstant).anIntegerValue/][else]0[/if][else]0[/if]..[if (v.theUpperBound.oclIsKindOf(IntegerConstant))][if (v.theUpperBound.oclAsType(IntegerConstant).anIntegerValue > 0)][v.theUpperBound.oclAsType(IntegerConstant).anIntegerValue/][else]0[/if][else]0[/if])
[/for]
[/if]
[for (sm : StateMachine in arr.stateMachine)]
[if (sm.localVariables.variables->notEmpty())]
[for (v : IntegerVariable in sm.localVariables.variables)]
    /\ [sm.name/]_[v.variableID/] \in ([if (v.theLowerBound.oclIsKindOf(IntegerConstant))][if (v.theLowerBound.oclAsType(IntegerConstant).anIntegerValue > 0)][v.theLowerBound.oclAsType(IntegerConstant).anIntegerValue/][else]0[/if][else]0[/if]..[if (v.theUpperBound.oclIsKindOf(IntegerConstant))][if (v.theUpperBound.oclAsType(IntegerConstant).anIntegerValue > 0)][v.theUpperBound.oclAsType(IntegerConstant).anIntegerValue/][else]0[/if][else]0[/if])
