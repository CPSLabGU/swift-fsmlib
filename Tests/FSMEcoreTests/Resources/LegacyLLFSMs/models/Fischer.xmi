<?xml version="1.0" encoding="UTF-8"?>
<newGITmetamodelwithtypes:Arrangement
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:newGITmetamodelwithtypes="http://www.example.org/newGITmetamodelwithtypes"
    xsi:schemaLocation="http://www.example.org/newGITmetamodelwithtypes ../metamodel/newGITmetamodelwithtypes.ecore"
    arrangementName="FischerConcurrencyAlgorithm">
  <stateMachine
      name="Starter">
    <initialState
        stateName="INITIAL">
      <onEntry>
        <statements
            xsi:type="newGITmetamodelwithtypes:OutputLine"
            theLine="Initialise shared varianle"/>
        <statements
            xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS"
            variable="//@whiteboardVariables/@variables.0">
          <anArithmeticExpression
              xsi:type="newGITmetamodelwithtypes:PredefinedIntegerConstant"
              listedIntegerConstant="//@integerConstantDefinitions/@definitionsIntegerConstants.0"/>
        </statements>
      </onEntry>
    </initialState>
  </stateMachine>
  <stateMachine
      name="Thread1">
    <initialState
        stateName="T1NonCriticalSection">
      <onEntry>
        <statements
            xsi:type="newGITmetamodelwithtypes:OutputLine"
            theLine="In T1 non critical section"/>
        <statements
            xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS"
            variable="//@stateMachine.1/@localVariables/@variables.0">
          <anArithmeticExpression
              xsi:type="newGITmetamodelwithtypes:IntegerConstant"
              anIntegerValue="1"/>
        </statements>
      </onEntry>
    </initialState>
    <states
        stateName="T1WAIT"/>
    <states
        stateName="T1ASSIGN">
      <onEntry>
        <statements
            xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS"
            variable="//@whiteboardVariables/@variables.0">
          <anArithmeticExpression
              xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
              theVariable="//@stateMachine.1/@localVariables/@variables.0"/>
        </statements>
      </onEntry>
    </states>
    <states
        stateName="T1CriticalSection">
      <onEntry>
        <statements
            xsi:type="newGITmetamodelwithtypes:OutputLine"
            theLine="In T1 critical section"/>
      </onEntry>
    </states>
    <states
        stateName="T1LetGo">
      <onEntry>
        <statements
            xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS"
            variable="//@whiteboardVariables/@variables.0">
          <anArithmeticExpression
              xsi:type="newGITmetamodelwithtypes:PredefinedIntegerConstant"
              listedIntegerConstant="//@integerConstantDefinitions/@definitionsIntegerConstants.0"/>
        </statements>
      </onEntry>
    </states>
    <transitions
        sourceState="//@stateMachine.1/@initialState"
        targetState="//@stateMachine.1/@states.0">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:TimeExpression">
        <timeBound
            xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
            theVariable="//@sensorVariables/@variables.0"/>
      </booleanExpression>
    </transitions>
    <transitions
        sourceState="//@stateMachine.1/@states.0"
        targetState="//@stateMachine.1/@states.1">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:EqualExpression">
        <leftExpression
            xsi:type="newGITmetamodelwithtypes:PredefinedIntegerConstant"
            listedIntegerConstant="//@integerConstantDefinitions/@definitionsIntegerConstants.0"/>
        <rightExpression
            xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
            theVariable="//@whiteboardVariables/@variables.0"/>
      </booleanExpression>
    </transitions>
    <transitions
        sourceState="//@stateMachine.1/@states.1"
        targetState="//@stateMachine.1/@states.0">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:NotExpression">
        <theExpression
            xsi:type="newGITmetamodelwithtypes:EqualExpression">
          <leftExpression
              xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
              theVariable="//@stateMachine.1/@localVariables/@variables.0"/>
          <rightExpression
              xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
              theVariable="//@whiteboardVariables/@variables.0"/>
        </theExpression>
      </booleanExpression>
    </transitions>
    <transitions
        sourceState="//@stateMachine.1/@states.1"
        targetState="//@stateMachine.1/@states.2">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:BooleanConstant"
          aBooleanValue="true"/>
    </transitions>
    <transitions
        sourceState="//@stateMachine.1/@states.2"
        targetState="//@stateMachine.1/@states.3">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:TimeExpression">
        <timeBound
            xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
            theVariable="//@sensorVariables/@variables.1"/>
      </booleanExpression>
    </transitions>
    <transitions
        sourceState="//@stateMachine.1/@states.3"
        targetState="//@stateMachine.1/@initialState">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:BooleanConstant"
          aBooleanValue="true"/>
    </transitions>
    <localVariables>
      <variables
          variableID="IamThreadT1">
        <theUpperBound
            xsi:type="newGITmetamodelwithtypes:IntegerConstant"
            anIntegerValue="1"/>
      </variables>
    </localVariables>
  </stateMachine>
  <stateMachine
      name="Thread2">
    <initialState
        stateName="T2NonCriticalSection">
      <onEntry>
        <statements
            xsi:type="newGITmetamodelwithtypes:OutputLine"
            theLine="In T2 non critical section"/>
        <statements
            xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS"
            variable="//@stateMachine.2/@localVariables/@variables.0">
          <anArithmeticExpression
              xsi:type="newGITmetamodelwithtypes:IntegerConstant"
              anIntegerValue="2"/>
        </statements>
      </onEntry>
    </initialState>
    <states
        stateName="T2WAIT"/>
    <states
        stateName="T2ASSIGN">
      <onEntry>
        <statements
            xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS"
            variable="//@whiteboardVariables/@variables.0">
          <anArithmeticExpression
              xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
              theVariable="//@stateMachine.2/@localVariables/@variables.0"/>
        </statements>
      </onEntry>
    </states>
    <states
        stateName="T2CriticalSection">
      <onEntry>
        <statements
            xsi:type="newGITmetamodelwithtypes:OutputLine"
            theLine="In T2 critical section"/>
      </onEntry>
    </states>
    <states
        stateName="T2LetGo">
      <onEntry>
        <statements
            xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS"
            variable="//@whiteboardVariables/@variables.0">
          <anArithmeticExpression
              xsi:type="newGITmetamodelwithtypes:PredefinedIntegerConstant"
              listedIntegerConstant="//@integerConstantDefinitions/@definitionsIntegerConstants.0"/>
        </statements>
      </onEntry>
    </states>
    <transitions
        sourceState="//@stateMachine.2/@initialState"
        targetState="//@stateMachine.2/@states.0">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:TimeExpression">
        <timeBound
            xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
            theVariable="//@sensorVariables/@variables.2"/>
      </booleanExpression>
    </transitions>
    <transitions
        sourceState="//@stateMachine.2/@states.0"
        targetState="//@stateMachine.2/@states.1">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:EqualExpression">
        <leftExpression
            xsi:type="newGITmetamodelwithtypes:PredefinedIntegerConstant"
            listedIntegerConstant="//@integerConstantDefinitions/@definitionsIntegerConstants.0"/>
        <rightExpression
            xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
            theVariable="//@whiteboardVariables/@variables.0"/>
      </booleanExpression>
    </transitions>
    <transitions
        sourceState="//@stateMachine.2/@states.1"
        targetState="//@stateMachine.2/@states.0">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:NotExpression">
        <theExpression
            xsi:type="newGITmetamodelwithtypes:EqualExpression">
          <leftExpression
              xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
              theVariable="//@stateMachine.2/@localVariables/@variables.0"/>
          <rightExpression
              xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
              theVariable="//@whiteboardVariables/@variables.0"/>
        </theExpression>
      </booleanExpression>
    </transitions>
    <transitions
        sourceState="//@stateMachine.2/@states.1"
        targetState="//@stateMachine.2/@states.2">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:BooleanConstant"
          aBooleanValue="true"/>
    </transitions>
    <transitions
        sourceState="//@stateMachine.2/@states.2"
        targetState="//@stateMachine.2/@states.3">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:TimeExpression">
        <timeBound
            xsi:type="newGITmetamodelwithtypes:IntegerVariableReference"
            theVariable="//@sensorVariables/@variables.3"/>
      </booleanExpression>
    </transitions>
    <transitions
        sourceState="//@stateMachine.2/@states.3"
        targetState="//@stateMachine.2/@initialState">
      <booleanExpression
          xsi:type="newGITmetamodelwithtypes:BooleanConstant"
          aBooleanValue="true"/>
    </transitions>
    <localVariables>
      <variables
          variableID="IamThreadT2">
        <theUpperBound
            xsi:type="newGITmetamodelwithtypes:IntegerConstant"
            anIntegerValue="2"/>
      </variables>
    </localVariables>
  </stateMachine>
  <sensorVariables>
    <variables
        variableID="Thread1NonCriticalSectionWCET">
      <theUpperBound
          xsi:type="newGITmetamodelwithtypes:IntegerConstant"
          anIntegerValue="3"/>
    </variables>
    <variables
        variableID="Thread1CriticalSectionWCET">
      <theUpperBound
          xsi:type="newGITmetamodelwithtypes:IntegerConstant"
          anIntegerValue="4"/>
    </variables>
    <variables
        variableID="Thread2NonCriticalSectionWCET">
      <theUpperBound
          xsi:type="newGITmetamodelwithtypes:IntegerConstant"
          anIntegerValue="2"/>
    </variables>
    <variables
        variableID="Thread2CriticalSectionWCET">
      <theUpperBound
          xsi:type="newGITmetamodelwithtypes:IntegerConstant"
          anIntegerValue="1"/>
    </variables>
  </sensorVariables>
  <whiteboardVariables>
    <variables
        variableID="SharedX">
      <theUpperBound
          xsi:type="newGITmetamodelwithtypes:IntegerConstant"
          anIntegerValue="2"/>
    </variables>
  </whiteboardVariables>
  <integerConstantDefinitions>
    <definitionsIntegerConstants
        Identifier="NotAThread"
        anIntegerValue="0"/>
    <definitionsIntegerConstants
        Identifier="GlobalWCET"
        anIntegerValue="3"/>
  </integerConstantDefinitions>
</newGITmetamodelwithtypes:Arrangement>
