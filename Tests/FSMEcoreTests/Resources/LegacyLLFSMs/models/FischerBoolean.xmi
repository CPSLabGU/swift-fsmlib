<?xml version="1.0" encoding="ASCII"?>
<newGITmetamodelwithtypes:Arrangement xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:newGITmetamodelwithtypes="http://www.example.org/newGITmetamodelwithtypes" arrangementName="FischerDelaysByBooleanSensors">
  <stateMachine name="STARTER">
    <initialState stateName="START">
      <onEntry>
        <statements xsi:type="newGITmetamodelwithtypes:OutputLine" theLine="Initialise shared variable"/>
        <statements xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS" variable="//@whiteboardVariables/@variables.0">
          <anArithmeticExpression xsi:type="newGITmetamodelwithtypes:PredefinedIntegerConstant" listedIntegerConstant="//@integerConstantDefinitions/@definitionsIntegerConstants.0"/>
        </statements>
      </onEntry>
    </initialState>
    <copies xsi:type="newGITmetamodelwithtypes:IntegerConstant" anIntegerValue="1"/>
  </stateMachine>
  <stateMachine name="THREAD_1">
    <initialState stateName="T1NonCriticalSection">
      <onEntry>
        <statements xsi:type="newGITmetamodelwithtypes:OutputLine" theLine="T1 in non-critical section"/>
        <statements xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS" variable="//@stateMachine.1/@localVariables/@variables.0">
          <anArithmeticExpression xsi:type="newGITmetamodelwithtypes:IntegerConstant" anIntegerValue="1"/>
        </statements>
      </onEntry>
    </initialState>
    <states stateName="T1Wait">
      <onEntry/>
    </states>
    <states stateName="T1Assign">
      <onEntry>
        <statements xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS" variable="//@whiteboardVariables/@variables.0">
          <anArithmeticExpression xsi:type="newGITmetamodelwithtypes:IntegerVariableReference" theVariable="//@stateMachine.1/@localVariables/@variables.0"/>
        </statements>
      </onEntry>
    </states>
    <states stateName="T1CriticalSection">
      <onEntry/>
    </states>
    <states stateName="T1LetGo">
      <onEntry>
        <statements xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS" variable="//@whiteboardVariables/@variables.0">
          <anArithmeticExpression xsi:type="newGITmetamodelwithtypes:PredefinedIntegerConstant" listedIntegerConstant="//@integerConstantDefinitions/@definitionsIntegerConstants.0"/>
        </statements>
      </onEntry>
    </states>
    <transitions sourceState="//@stateMachine.1/@initialState" targetState="//@stateMachine.1/@states.0">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:BooleanVariableReference" theVariable="//@booleanSensorVariables/@variables.0"/>
    </transitions>
    <transitions sourceState="//@stateMachine.1/@states.0" targetState="//@stateMachine.1/@states.1">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:EqualExpression">
        <leftExpression xsi:type="newGITmetamodelwithtypes:PredefinedIntegerConstant" listedIntegerConstant="//@integerConstantDefinitions/@definitionsIntegerConstants.0"/>
        <rightExpression xsi:type="newGITmetamodelwithtypes:IntegerVariableReference" theVariable="//@whiteboardVariables/@variables.0"/>
      </booleanExpression>
    </transitions>
    <transitions sourceState="//@stateMachine.1/@states.1" targetState="//@stateMachine.1/@states.0">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:NotExpression">
        <theExpression xsi:type="newGITmetamodelwithtypes:EqualExpression">
          <leftExpression xsi:type="newGITmetamodelwithtypes:IntegerVariableReference" theVariable="//@stateMachine.1/@localVariables/@variables.0"/>
          <rightExpression xsi:type="newGITmetamodelwithtypes:IntegerVariableReference" theVariable="//@whiteboardVariables/@variables.0"/>
        </theExpression>
      </booleanExpression>
    </transitions>
    <transitions sourceState="//@stateMachine.1/@states.1" targetState="//@stateMachine.1/@states.2">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:BooleanConstant" aBooleanValue="true"/>
    </transitions>
    <transitions sourceState="//@stateMachine.1/@states.2" targetState="//@stateMachine.1/@states.3">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:BooleanVariableReference" theVariable="//@booleanSensorVariables/@variables.1"/>
    </transitions>
    <transitions sourceState="//@stateMachine.1/@states.3" targetState="//@stateMachine.1/@initialState">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:BooleanConstant" aBooleanValue="true"/>
    </transitions>
    <localVariables>
      <variables variableID="IamThreadT1">
        <theUpperBound xsi:type="newGITmetamodelwithtypes:IntegerConstant" anIntegerValue="2"/>
        <theLowerBound xsi:type="newGITmetamodelwithtypes:IntegerConstant"/>
      </variables>
    </localVariables>
    <copies xsi:type="newGITmetamodelwithtypes:IntegerConstant" anIntegerValue="1"/>
  </stateMachine>
  <stateMachine name="THREAD_2">
    <initialState stateName="T2NonCriticalSection">
      <onEntry>
        <statements xsi:type="newGITmetamodelwithtypes:OutputLine" theLine="T2 in non-critical section"/>
        <statements xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS" variable="//@stateMachine.2/@localVariables/@variables.0">
          <anArithmeticExpression xsi:type="newGITmetamodelwithtypes:IntegerConstant" anIntegerValue="2"/>
        </statements>
      </onEntry>
    </initialState>
    <states stateName="T2Wait">
      <onEntry/>
    </states>
    <states stateName="T2Assign">
      <onEntry>
        <statements xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS" variable="//@whiteboardVariables/@variables.0">
          <anArithmeticExpression xsi:type="newGITmetamodelwithtypes:IntegerVariableReference" theVariable="//@stateMachine.2/@localVariables/@variables.0"/>
        </statements>
      </onEntry>
    </states>
    <states stateName="T2CriticalSection">
      <onEntry/>
    </states>
    <states stateName="T2LetGo">
      <onEntry>
        <statements xsi:type="newGITmetamodelwithtypes:AssignmentIntegerLHS" variable="//@whiteboardVariables/@variables.0">
          <anArithmeticExpression xsi:type="newGITmetamodelwithtypes:PredefinedIntegerConstant" listedIntegerConstant="//@integerConstantDefinitions/@definitionsIntegerConstants.0"/>
        </statements>
      </onEntry>
    </states>
    <transitions sourceState="//@stateMachine.2/@initialState" targetState="//@stateMachine.2/@states.0">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:BooleanVariableReference" theVariable="//@booleanSensorVariables/@variables.2"/>
    </transitions>
    <transitions sourceState="//@stateMachine.2/@states.0" targetState="//@stateMachine.2/@states.1">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:EqualExpression">
        <leftExpression xsi:type="newGITmetamodelwithtypes:PredefinedIntegerConstant" listedIntegerConstant="//@integerConstantDefinitions/@definitionsIntegerConstants.0"/>
        <rightExpression xsi:type="newGITmetamodelwithtypes:IntegerVariableReference" theVariable="//@whiteboardVariables/@variables.0"/>
      </booleanExpression>
    </transitions>
    <transitions sourceState="//@stateMachine.2/@states.1" targetState="//@stateMachine.2/@states.0">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:NotExpression">
        <theExpression xsi:type="newGITmetamodelwithtypes:EqualExpression">
          <leftExpression xsi:type="newGITmetamodelwithtypes:IntegerVariableReference" theVariable="//@stateMachine.2/@localVariables/@variables.0"/>
          <rightExpression xsi:type="newGITmetamodelwithtypes:IntegerVariableReference" theVariable="//@whiteboardVariables/@variables.0"/>
        </theExpression>
      </booleanExpression>
    </transitions>
    <transitions sourceState="//@stateMachine.2/@states.1" targetState="//@stateMachine.2/@states.2">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:BooleanConstant" aBooleanValue="true"/>
    </transitions>
    <transitions sourceState="//@stateMachine.2/@states.2" targetState="//@stateMachine.2/@states.3">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:BooleanVariableReference" theVariable="//@booleanSensorVariables/@variables.3"/>
    </transitions>
    <transitions sourceState="//@stateMachine.2/@states.3" targetState="//@stateMachine.2/@initialState">
      <booleanExpression xsi:type="newGITmetamodelwithtypes:BooleanConstant" aBooleanValue="true"/>
    </transitions>
    <localVariables>
      <variables variableID="IamThreadT2">
        <theUpperBound xsi:type="newGITmetamodelwithtypes:IntegerConstant" anIntegerValue="2"/>
        <theLowerBound xsi:type="newGITmetamodelwithtypes:IntegerConstant"/>
      </variables>
    </localVariables>
    <copies xsi:type="newGITmetamodelwithtypes:IntegerConstant" anIntegerValue="1"/>
  </stateMachine>
  <booleanSensorVariables>
    <variables variableID="T1NonCriticalSectionDelay"/>
    <variables variableID="T1CriticalSectionDelay"/>
    <variables variableID="T2NonCriticalSectionDelay"/>
    <variables variableID="T2CriticalSectionDelay"/>
  </booleanSensorVariables>
  <whiteboardVariables>
    <variables variableID="SharedX">
      <theUpperBound xsi:type="newGITmetamodelwithtypes:IntegerConstant" anIntegerValue="2"/>
      <theLowerBound xsi:type="newGITmetamodelwithtypes:IntegerConstant"/>
    </variables>
  </whiteboardVariables>
  <integerConstantDefinitions>
    <definitionsIntegerConstants xsi:type="newGITmetamodelwithtypes:GlobalIntegerConstantMetaModelDefinition" Identifier="NotAThread" anIntegerValue="0"/>
  </integerConstantDefinitions>
</newGITmetamodelwithtypes:Arrangement>
