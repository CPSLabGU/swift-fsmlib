MODULE g_c
-- This module models global constants in arrangement of LLFSMs-- (See:-- Carrillo, M. Estivill-Castro, V. Rosenblueth, D. A. 'Verification and Simulation of Time-Domain Properties for Models of Behaviour'--  S. Hammoudi et al. (Eds.): MODELSWARD 2020, CCIS 1361, pp. 1-25, 2021--    https://doi.org/10.1007/978-3-030-67445-8_10)

DEFINE NotAThread := 0;

-- End g_c -------------------------------------------------------------


MODULE Sensor (g_c)
-- This module models sensor variables of an arrangement of LLFSMs-- (See:-- Carrillo, M. Estivill-Castro, V. Rosenblueth, D. A. 'Verification and Simulation of Time-Domain Properties for Models of Behaviour'--  S. Hammoudi et al. (Eds.): MODELSWARD 2020, CCIS 1361, pp. 1-25, 2021--    https://doi.org/10.1007/978-3-030-67445-8_10)-- Intuitively, for all sensor variable Si, Si has a non-deterministic value.-- Input: (NO INPUTS)
-- Sensor variables:
VAR


	T1NonCriticalSectionDelay:boolean;

	T1CriticalSectionDelay:boolean;

	T2NonCriticalSectionDelay:boolean;

	T2CriticalSectionDelay:boolean;




TRANS
-- For all sensor variable Si, Si has a non-deterministic value:
	TRUE; -- No constraint on transitions.

-- End Sensor -------------------------------------------------------------


MODULE Whiteboard (turn ,turnsOfSharedX,g_c)
-- Parameters:    (turn, turnsOfW1, turnsOfW2, ...), where each Wi is the name of a whiteboard variable.
-- This module models Whiteboard variables of an arrangement of LLFSMs-- (See:-- Carrillo, M. Estivill-Castro, V. Rosenblueth, D. A. 'Verification and Simulation of Time-Domain Properties for Models of Behaviour'--  S. Hammoudi et al. (Eds.): MODELSWARD 2020, CCIS 1361, pp. 1-25, 2021--    https://doi.org/10.1007/978-3-030-67445-8_10)-- Intuitively, for all Whiteboard variable Wi:
-- 	this module keeps the value of Wi when the current turn is not one of the turns where Wi can be modified.
-- Input:
-- 	turn: 	Current turn
-- 	turnsOfWi: 	Set of turns where variable named Wi is modified (for each whiteboard variable named Wi).

-- Whiteboard variables:
VAR

	SharedX:0..2;




TRANS

	(! (turn in turnsOfSharedX)
	-> next(SharedX) = SharedX)



-- End Whiteboard -------------------------------------------------------------




MODULE STARTER(executing_, SharedX,g_c) -- Parameters

-- STARTER is a NuSMV module modelling a LLFSM for IMP,
-- a logic-labelled finite-state machine[2] for IMP language [3].
-- mcb & vec

-- Variable Program Counter (states) for STARTER:
-- State_Names= ["dInitSTARTER", "START"]
VAR
pc_STARTER : 0..1;

VAR
-- Local variables for  module STARTER:


-- Initial state constraints for LLFSM STARTER:
-- Initial state of LLFSM STARTER (pc_):
INIT
(pc_STARTER = 0)

-- Define declarations of LLFSM STARTER:
DEFINE -- Definitions for easy formula about reaching a state:
	At_PSEUDO_INITIAL := (pc_STARTER=0);
	At_START := (pc_STARTER=1);

DEFINE
condT00 :=
	((  (pc_STARTER= 0)) & TRUE);

condDefault0 :=
	((!condT00));

-- Transition constraints of LLFSM  STARTER:
-- Tran(STARTER) = [(0, 1, 1) ]
-- State_Names= ["dInitSTARTER", "START"]
TRANS
 (!executing_ -> -- If this module is not executing, then keep the values of local variables
		 -- NOTE: The w_b module and the Effector module preserve values of any variables in LHS of such classes
		((next(pc_STARTER)=pc_STARTER)) 	) -- NOT executing
	& (executing_ -> -- If this module is executing, use the defined conditions to perform transitions orderly:
	( (TRUE &  -- Ncond
	condT00 &  -- Pcond
		(next(pc_STARTER) = 1) & (next(SharedX)=g_c.NotAThread)
		) -- Next

	|
	(condDefault0 &  -- Ncond
	TRUE &  -- Pcond
	(next(pc_STARTER) = pc_STARTER)  & (next(SharedX)=SharedX)	)  -- Next
	)  -- Consequent executing
)  -- closing executing

-- End STARTER -------------------------------------------------------------




MODULE THREAD_1(executing_, T1NonCriticalSectionDelay, T1CriticalSectionDelay, SharedX,g_c) -- Parameters

-- THREAD_1 is a NuSMV module modelling a LLFSM for IMP,
-- a logic-labelled finite-state machine[2] for IMP language [3].
-- mcb & vec

-- Variable Program Counter (states) for THREAD_1:
-- State_Names= ["dInitTHREAD_1", "T1NonCriticalSection", "T1Wait", "T1Assign", "T1CriticalSection", "T1LetGo"]
VAR
pc_THREAD_1 : 0..5;

VAR
-- Local variables for  module THREAD_1:


IamThreadT1 : 0.. 2;



-- Initial state constraints for LLFSM THREAD_1:
-- Initial state of LLFSM THREAD_1 (pc_):
INIT
(pc_THREAD_1 = 0)

-- Define declarations of LLFSM THREAD_1:
DEFINE -- Definitions for easy formula about reaching a state:
	At_PSEUDO_INITIAL := (pc_THREAD_1=0);
	At_T1NonCriticalSection := (pc_THREAD_1=1);

	At_T1Wait := (pc_THREAD_1=2);

	At_T1Assign := (pc_THREAD_1=3);

	At_T1CriticalSection := (pc_THREAD_1=4);

	At_T1LetGo := (pc_THREAD_1=5);

DEFINE
condT10 :=
	((  (pc_THREAD_1= 0)) & TRUE);


condT11:=
	(( (pc_THREAD_1= 1)) & (T1NonCriticalSectionDelay));



condT12:=
	(( (pc_THREAD_1= 2)) & (g_c.NotAThread = (SharedX)));



condT13:=
	(( (pc_THREAD_1= 3)) & (! ((IamThreadT1) = (SharedX))));



condT14:=
	(( (pc_THREAD_1= 3)) & TRUE);



condT15:=
	(( (pc_THREAD_1= 4)) & (T1CriticalSectionDelay));



condT16:=
	(( (pc_THREAD_1= 5)) & TRUE);


condDefault1 :=
	((!condT10) & (!condT11) & (!condT12) & (!condT13) & (!condT14) & (!condT15) & (!condT16));

-- Transition constraints of LLFSM  THREAD_1:
-- Tran(THREAD_1) = [(0, 1, 1) (1, 1, 2)(2, 1, 3)(3, 1, 2)(3, 1, 4)(4, 1, 5)(5, 1, 1)]
-- State_Names= ["dInitTHREAD_1", "T1NonCriticalSection", "T1Wait", "T1Assign", "T1CriticalSection", "T1LetGo"]
TRANS
 (!executing_ -> -- If this module is not executing, then keep the values of local variables
		 -- NOTE: The w_b module and the Effector module preserve values of any variables in LHS of such classes
		((next(pc_THREAD_1)=pc_THREAD_1)& (next(IamThreadT1)=IamThreadT1)) 	) -- NOT executing
	& (executing_ -> -- If this module is executing, use the defined conditions to perform transitions orderly:
	( (TRUE &  -- Ncond
	condT10 &  -- Pcond
		(next(pc_THREAD_1) = 1) & (next(IamThreadT1)=1) & (next(SharedX)=SharedX)
		) -- Next


	|
	((!condT10) &   -- Ncond
	condT11 & -- Pcond
		(next(pc_THREAD_1) = 2)  & (next(IamThreadT1)=IamThreadT1) & (next(SharedX)=SharedX)
		)  -- Next



	|
	((!condT10) & (!condT11) &   -- Ncond
	condT12 & -- Pcond
		(next(pc_THREAD_1) = 3)  & (next(IamThreadT1)=IamThreadT1) & (next(SharedX)=IamThreadT1)
		)  -- Next



	|
	((!condT10) & (!condT11) & (!condT12) &   -- Ncond
	condT13 & -- Pcond
		(next(pc_THREAD_1) = 2)  & (next(IamThreadT1)=IamThreadT1) & (next(SharedX)=SharedX)
		)  -- Next



	|
	((!condT10) & (!condT11) & (!condT12) & (!condT13) &   -- Ncond
	condT14 & -- Pcond
		(next(pc_THREAD_1) = 4)  & (next(IamThreadT1)=IamThreadT1) & (next(SharedX)=SharedX)
		)  -- Next



	|
	((!condT10) & (!condT11) & (!condT12) & (!condT13) & (!condT14) &   -- Ncond
	condT15 & -- Pcond
		(next(pc_THREAD_1) = 5)  & (next(IamThreadT1)=IamThreadT1) & (next(SharedX)=g_c.NotAThread)
		)  -- Next



	|
	((!condT10) & (!condT11) & (!condT12) & (!condT13) & (!condT14) & (!condT15) &   -- Ncond
	condT16 & -- Pcond
		(next(pc_THREAD_1) = 1)  & (next(IamThreadT1)=1) & (next(SharedX)=SharedX)
		)  -- Next


	|
	(condDefault1 &  -- Ncond
	TRUE &  -- Pcond
	(next(pc_THREAD_1) = pc_THREAD_1)  & (next(IamThreadT1)=IamThreadT1) & (next(SharedX)=SharedX)	)  -- Next
	)  -- Consequent executing
)  -- closing executing

-- End THREAD_1 -------------------------------------------------------------




MODULE THREAD_2(executing_, T2NonCriticalSectionDelay, T2CriticalSectionDelay, SharedX,g_c) -- Parameters

-- THREAD_2 is a NuSMV module modelling a LLFSM for IMP,
-- a logic-labelled finite-state machine[2] for IMP language [3].
-- mcb & vec

-- Variable Program Counter (states) for THREAD_2:
-- State_Names= ["dInitTHREAD_2", "T2NonCriticalSection", "T2Wait", "T2Assign", "T2CriticalSection", "T2LetGo"]
VAR
pc_THREAD_2 : 0..5;

VAR
-- Local variables for  module THREAD_2:


IamThreadT2 : 0.. 2;



-- Initial state constraints for LLFSM THREAD_2:
-- Initial state of LLFSM THREAD_2 (pc_):
INIT
(pc_THREAD_2 = 0)

-- Define declarations of LLFSM THREAD_2:
DEFINE -- Definitions for easy formula about reaching a state:
	At_PSEUDO_INITIAL := (pc_THREAD_2=0);
	At_T2NonCriticalSection := (pc_THREAD_2=1);

	At_T2Wait := (pc_THREAD_2=2);

	At_T2Assign := (pc_THREAD_2=3);

	At_T2CriticalSection := (pc_THREAD_2=4);

	At_T2LetGo := (pc_THREAD_2=5);

DEFINE
condT20 :=
	((  (pc_THREAD_2= 0)) & TRUE);


condT21:=
	(( (pc_THREAD_2= 1)) & (T2NonCriticalSectionDelay));



condT22:=
	(( (pc_THREAD_2= 2)) & (g_c.NotAThread = (SharedX)));



condT23:=
	(( (pc_THREAD_2= 3)) & (! ((IamThreadT2) = (SharedX))));



condT24:=
	(( (pc_THREAD_2= 3)) & TRUE);



condT25:=
	(( (pc_THREAD_2= 4)) & (T2CriticalSectionDelay));



condT26:=
	(( (pc_THREAD_2= 5)) & TRUE);


condDefault2 :=
	((!condT20) & (!condT21) & (!condT22) & (!condT23) & (!condT24) & (!condT25) & (!condT26));

-- Transition constraints of LLFSM  THREAD_2:
-- Tran(THREAD_2) = [(0, 1, 1) (1, 1, 2)(2, 1, 3)(3, 1, 2)(3, 1, 4)(4, 1, 5)(5, 1, 1)]
-- State_Names= ["dInitTHREAD_2", "T2NonCriticalSection", "T2Wait", "T2Assign", "T2CriticalSection", "T2LetGo"]
TRANS
 (!executing_ -> -- If this module is not executing, then keep the values of local variables
		 -- NOTE: The w_b module and the Effector module preserve values of any variables in LHS of such classes
		((next(pc_THREAD_2)=pc_THREAD_2)& (next(IamThreadT2)=IamThreadT2)) 	) -- NOT executing
	& (executing_ -> -- If this module is executing, use the defined conditions to perform transitions orderly:
	( (TRUE &  -- Ncond
	condT20 &  -- Pcond
		(next(pc_THREAD_2) = 1) & (next(IamThreadT2)=2) & (next(SharedX)=SharedX)
		) -- Next


	|
	((!condT20) &   -- Ncond
	condT21 & -- Pcond
		(next(pc_THREAD_2) = 2)  & (next(IamThreadT2)=IamThreadT2) & (next(SharedX)=SharedX)
		)  -- Next



	|
	((!condT20) & (!condT21) &   -- Ncond
	condT22 & -- Pcond
		(next(pc_THREAD_2) = 3)  & (next(IamThreadT2)=IamThreadT2) & (next(SharedX)=IamThreadT2)
		)  -- Next



	|
	((!condT20) & (!condT21) & (!condT22) &   -- Ncond
	condT23 & -- Pcond
		(next(pc_THREAD_2) = 2)  & (next(IamThreadT2)=IamThreadT2) & (next(SharedX)=SharedX)
		)  -- Next



	|
	((!condT20) & (!condT21) & (!condT22) & (!condT23) &   -- Ncond
	condT24 & -- Pcond
		(next(pc_THREAD_2) = 4)  & (next(IamThreadT2)=IamThreadT2) & (next(SharedX)=SharedX)
		)  -- Next



	|
	((!condT20) & (!condT21) & (!condT22) & (!condT23) & (!condT24) &   -- Ncond
	condT25 & -- Pcond
		(next(pc_THREAD_2) = 5)  & (next(IamThreadT2)=IamThreadT2) & (next(SharedX)=g_c.NotAThread)
		)  -- Next



	|
	((!condT20) & (!condT21) & (!condT22) & (!condT23) & (!condT24) & (!condT25) &   -- Ncond
	condT26 & -- Pcond
		(next(pc_THREAD_2) = 1)  & (next(IamThreadT2)=2) & (next(SharedX)=SharedX)
		)  -- Next


	|
	(condDefault2 &  -- Ncond
	TRUE &  -- Pcond
	(next(pc_THREAD_2) = pc_THREAD_2)  & (next(IamThreadT2)=IamThreadT2) & (next(SharedX)=SharedX)	)  -- Next
	)  -- Consequent executing
)  -- closing executing

-- End THREAD_2 -------------------------------------------------------------



MODULE RoundRobinScheduler()-- This module models a round robin scheduler of an arrangement of LLFSMs-- (See:-- Carrillo, M. Estivill-Castro, V. Rosenblueth, D. A. 'Verification and Simulation of Time-Domain Properties for Models of Behaviour'--  S. Hammoudi et al. (Eds.): MODELSWARD 2020, CCIS 1361, pp. 1-25, 2021--    https://doi.org/10.1007/978-3-030-67445-8_10)-- Input: (NO INPUTS)

-- Output: turn

--
-- Variable to record the execution turn:
VAR
	turn : 0..2;

DEFINE


	executing_0:= (turn=0);



	executing_1:= (turn=1);



	executing_2:= (turn=2);




	executing_STARTER:= (turn=0);



	executing_THREAD_1:= (turn=1);



	executing_THREAD_2:= (turn=2);


-- Initial states for RoundRobinScheduler module (turn and whiteboard variables):
INIT
	(TRUE & TRUE)

-- Transitions for RoundRobinScheduler module:
TRANS



	((turn=0) & -- cond
		next(turn=1) ) -- next




	|

	((turn=1) & -- cond
		next(turn=2) ) -- next




	|

	((turn=2) & -- cond
		next(turn=0) ) -- next



-- End RoundRobinScheduler -------------------------------------------------------------

MODULE main
-- Text of this NuSMV module was automatically generated by Java EMF model converter implemented  in:
--       Netbeans project JavaLLFSMsTransformation
-- The input model is in the configuration file but see arrangement name below
-- The output is a modular NuSMV model is FischerDelaysByBooleanSensors.smv
-- This is the main module of NuSMV file modelling an arrangement of LLFSMs:FischerDelaysByBooleanSensors
-- Exported to a NuSMV file an arrangement of logic-labelled finite-state machines (LLFSMs)[2]
-- for the IMP language [3].
-- Control of the arrangement is exported to the Main module of the NuSMV file.
-- Each LLFSM of the arrangement is exported to a NuSMV module.
-- [2] Estivill-Castro V, Hexel R, Lusty C. High performance relaying of C++11 objects across processes and logic-labeled finite-state machines. International Conference on Simulation, Modeling, and Programming for Autonomous Robots, pp. 182-194. Springer, 2014
-- [3] Winskel G. The formal semantics of programming languages: an introduction. MIT press, 1993.

--
-- Instance for global constants, we always have one
-- Instance for scheduler, we always have one
VAR

g_c:g_c();

sch:RoundRobinScheduler();
--

-- Instance for sensor variables: they are always read only
Sensor:Sensor(g_c);


w_b: Whiteboard(sch.turn

	-- turnsOfSharedX
, {0,1,2},g_c);




STARTER : STARTER(sch.executing_0, w_b.SharedX,g_c);




THREAD_1 : THREAD_1(sch.executing_1, Sensor.T1NonCriticalSectionDelay, Sensor.T1CriticalSectionDelay, w_b.SharedX,g_c);




THREAD_2 : THREAD_2(sch.executing_2, Sensor.T2NonCriticalSectionDelay, Sensor.T2CriticalSectionDelay, w_b.SharedX,g_c);



--
-- End  -------------------------------------------------------------

