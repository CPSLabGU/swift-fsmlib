<?xml version="1.0" encoding="UTF-8"?>
<sectioned:Arrangement xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sectioned="http://cpslabgu.github.io/llfsm/sectioned" xmlns:kernel="http://cpslabgu.github.io/llfsm/kernel" name="SuspendResumeSampler">
  <types xsi:type="kernel:BooleanType" name="Bool"/>
  <types xsi:type="kernel:IntegerType" name="Count" upper="100"/>
  <variables name="pauseRequested" type="kernel:BooleanType #//@types.0" external="true"/>
  <variables name="samples" type="kernel:IntegerType #//@types.1"/>
  <machines name="Sampler" initial="#//@machines.0/@states.0" suspendState="#//@machines.0/@states.2">
    <states name="Idle">
      <onEntry xsi:type="kernel:Print" text="idle"/>
      <transitions target="#//@machines.0/@states.1">
        <label xsi:type="kernel:BinaryExpression" operation="greaterThan">
          <left xsi:type="sectioned:StateTimeExpression" unit="milliseconds"/>
          <right xsi:type="kernel:IntegerLiteral" value="100"/>
        </label>
      </transitions>
    </states>
    <states name="Sampling">
      <onEntry xsi:type="kernel:Assignment">
        <target variable="#//@variables.1"/>
        <value xsi:type="kernel:BinaryExpression" operation="addition">
          <left xsi:type="kernel:VariableReference" variable="#//@variables.1"/>
          <right xsi:type="kernel:IntegerLiteral" value="1"/>
        </value>
      </onEntry>
      <onExit xsi:type="kernel:Print" text="done"/>
      <internal xsi:type="kernel:Print" text="sampling">
        <values xsi:type="kernel:VariableReference" variable="#//@variables.1"/>
      </internal>
      <onSuspend xsi:type="kernel:Print" text="suspending"/>
      <onResume xsi:type="kernel:Print" text="resuming"/>
      <transitions target="#//@machines.0/@states.0">
        <label xsi:type="kernel:BinaryExpression" operation="greaterOrEqual">
          <left xsi:type="kernel:VariableReference" variable="#//@variables.1"/>
          <right xsi:type="kernel:IntegerLiteral" value="100"/>
        </label>
      </transitions>
    </states>
    <states name="Suspended">
      <onEntry xsi:type="kernel:Print" text="suspended"/>
      <onResume xsi:type="kernel:Print" text="leaving suspension"/>
    </states>
  </machines>
  <machines name="Supervisor" initial="#//@machines.1/@states.0">
    <states name="Watching">
      <transitions target="#//@machines.1/@states.1">
        <label xsi:type="kernel:VariableReference" variable="#//@variables.0"/>
      </transitions>
    </states>
    <states name="Holding">
      <onEntry xsi:type="sectioned:MachineControlStatement" instance="#//@instances.0"/>
      <onExit xsi:type="sectioned:MachineControlStatement" operation="resume" instance="#//@instances.0"/>
      <transitions target="#//@machines.1/@states.0">
        <label xsi:type="kernel:BinaryExpression">
          <left xsi:type="kernel:UnaryExpression">
            <operand xsi:type="kernel:VariableReference" variable="#//@variables.0"/>
          </left>
          <right xsi:type="sectioned:InStateExpression" instance="#//@instances.0" state="#//@machines.0/@states.2"/>
        </label>
      </transitions>
    </states>
  </machines>
  <instances name="worker" machine="#//@machines.0"/>
  <instances name="supervisor" machine="#//@machines.1"/>
</sectioned:Arrangement>
