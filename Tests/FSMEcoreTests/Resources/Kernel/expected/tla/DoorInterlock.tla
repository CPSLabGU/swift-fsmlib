---------------------------- MODULE DoorInterlock ----------------------------
\* Generated by the tla templates from the arrangement DoorInterlock.
EXTENDS Integers
CONSTANT MaxRounds
ASSUME MaxRounds \in Nat
VARIABLE turn
VARIABLE round
VARIABLE pc_lock
VARIABLE entered_lock
VARIABLE pc_watch
VARIABLE entered_watch
VARIABLE doorClosed
VARIABLE motorOn
VARIABLE fn_isSafe
vars == <<turn, round, pc_lock, entered_lock, pc_watch, entered_watch, doorClosed, motorOn, fn_isSafe>>
TypeOK ==
  /\ turn \in 0..1
  /\ round \in 0..MaxRounds
  /\ pc_lock \in {"Idle", "Running", "Halting"}
  /\ entered_lock \in BOOLEAN
  /\ pc_watch \in {"Quiet", "Alarm"}
  /\ entered_watch \in BOOLEAN
  /\ doorClosed \in BOOLEAN
  /\ motorOn \in BOOLEAN
  /\ fn_isSafe \in [BOOLEAN -> BOOLEAN]
Init ==
  /\ turn = 0
  /\ round = 0
  /\ pc_lock = "Idle"
  /\ entered_lock = TRUE
  /\ pc_watch = "Quiet"
  /\ entered_watch = TRUE
  /\ doorClosed \in BOOLEAN
  /\ motorOn = FALSE
  /\ fn_isSafe \in [BOOLEAN -> BOOLEAN]
Halted ==
  /\ turn = 0
  /\ pc_lock \in {}
  /\ ~entered_lock
  /\ pc_watch \in {}
  /\ ~entered_watch
Run_lock_Idle ==
  /\ turn = 0
  /\ pc_lock = "Idle"
  /\ entered_lock
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_lock
  /\ entered_lock' = FALSE
  /\ UNCHANGED pc_watch
  /\ UNCHANGED entered_watch
  /\ UNCHANGED doorClosed
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Fire1_lock_Idle ==
  /\ turn = 0
  /\ pc_lock = "Idle"
  /\ ~entered_lock
  /\ fn_isSafe[doorClosed]
  /\ turn' = 1
  /\ UNCHANGED round
  /\ pc_lock' = "Running"
  /\ entered_lock' = TRUE
  /\ UNCHANGED pc_watch
  /\ UNCHANGED entered_watch
  /\ doorClosed' \in BOOLEAN
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Yield_lock_Idle ==
  /\ turn = 0
  /\ pc_lock = "Idle"
  /\ ~entered_lock
  /\ ~fn_isSafe[doorClosed]
  /\ ~Halted
  /\ turn' = 1
  /\ UNCHANGED round
  /\ UNCHANGED pc_lock
  /\ UNCHANGED entered_lock
  /\ UNCHANGED pc_watch
  /\ UNCHANGED entered_watch
  /\ doorClosed' \in BOOLEAN
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Step_lock_Idle ==
  \/ Run_lock_Idle
  \/ Fire1_lock_Idle
  \/ Yield_lock_Idle
Run_lock_Running ==
  /\ turn = 0
  /\ pc_lock = "Running"
  /\ entered_lock
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_lock
  /\ entered_lock' = FALSE
  /\ UNCHANGED pc_watch
  /\ UNCHANGED entered_watch
  /\ UNCHANGED doorClosed
  /\ motorOn' = TRUE
  /\ UNCHANGED <<fn_isSafe>>
Chain1_lock_Running ==
  /\ turn = 0
  /\ pc_lock = "Running"
  /\ ~entered_lock
  /\ (~doorClosed)
  /\ UNCHANGED <<turn, round>>
  /\ pc_lock' = "Halting"
  /\ entered_lock' = TRUE
  /\ UNCHANGED pc_watch
  /\ UNCHANGED entered_watch
  /\ UNCHANGED doorClosed
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Yield_lock_Running ==
  /\ turn = 0
  /\ pc_lock = "Running"
  /\ ~entered_lock
  /\ ~(~doorClosed)
  /\ ~Halted
  /\ turn' = 1
  /\ UNCHANGED round
  /\ UNCHANGED pc_lock
  /\ UNCHANGED entered_lock
  /\ UNCHANGED pc_watch
  /\ UNCHANGED entered_watch
  /\ doorClosed' \in BOOLEAN
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Step_lock_Running ==
  \/ Run_lock_Running
  \/ Chain1_lock_Running
  \/ Yield_lock_Running
Run_lock_Halting ==
  /\ turn = 0
  /\ pc_lock = "Halting"
  /\ entered_lock
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_lock
  /\ entered_lock' = FALSE
  /\ UNCHANGED pc_watch
  /\ UNCHANGED entered_watch
  /\ UNCHANGED doorClosed
  /\ motorOn' = FALSE
  /\ UNCHANGED <<fn_isSafe>>
Fire1_lock_Halting ==
  /\ turn = 0
  /\ pc_lock = "Halting"
  /\ ~entered_lock
  /\ TRUE
  /\ turn' = 1
  /\ UNCHANGED round
  /\ pc_lock' = "Idle"
  /\ entered_lock' = TRUE
  /\ UNCHANGED pc_watch
  /\ UNCHANGED entered_watch
  /\ doorClosed' \in BOOLEAN
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Yield_lock_Halting ==
  /\ turn = 0
  /\ pc_lock = "Halting"
  /\ ~entered_lock
  /\ ~TRUE
  /\ ~Halted
  /\ turn' = 1
  /\ UNCHANGED round
  /\ UNCHANGED pc_lock
  /\ UNCHANGED entered_lock
  /\ UNCHANGED pc_watch
  /\ UNCHANGED entered_watch
  /\ doorClosed' \in BOOLEAN
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Step_lock_Halting ==
  \/ Run_lock_Halting
  \/ Fire1_lock_Halting
  \/ Yield_lock_Halting
Run_watch_Quiet ==
  /\ turn = 1
  /\ pc_watch = "Quiet"
  /\ entered_watch
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_lock
  /\ UNCHANGED entered_lock
  /\ UNCHANGED pc_watch
  /\ entered_watch' = FALSE
  /\ UNCHANGED doorClosed
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Fire1_watch_Quiet ==
  /\ turn = 1
  /\ pc_watch = "Quiet"
  /\ ~entered_watch
  /\ ((pc_lock = "Running") /\ (~doorClosed))
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_lock
  /\ UNCHANGED entered_lock
  /\ pc_watch' = "Alarm"
  /\ entered_watch' = TRUE
  /\ doorClosed' \in BOOLEAN
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Yield_watch_Quiet ==
  /\ turn = 1
  /\ pc_watch = "Quiet"
  /\ ~entered_watch
  /\ ~((pc_lock = "Running") /\ (~doorClosed))
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_lock
  /\ UNCHANGED entered_lock
  /\ UNCHANGED pc_watch
  /\ UNCHANGED entered_watch
  /\ doorClosed' \in BOOLEAN
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Step_watch_Quiet ==
  \/ Run_watch_Quiet
  \/ Fire1_watch_Quiet
  \/ Yield_watch_Quiet
Run_watch_Alarm ==
  /\ turn = 1
  /\ pc_watch = "Alarm"
  /\ entered_watch
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_lock
  /\ UNCHANGED entered_lock
  /\ UNCHANGED pc_watch
  /\ entered_watch' = FALSE
  /\ UNCHANGED doorClosed
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Fire1_watch_Alarm ==
  /\ turn = 1
  /\ pc_watch = "Alarm"
  /\ ~entered_watch
  /\ (pc_lock = "Idle")
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_lock
  /\ UNCHANGED entered_lock
  /\ pc_watch' = "Quiet"
  /\ entered_watch' = TRUE
  /\ doorClosed' \in BOOLEAN
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Yield_watch_Alarm ==
  /\ turn = 1
  /\ pc_watch = "Alarm"
  /\ ~entered_watch
  /\ ~(pc_lock = "Idle")
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_lock
  /\ UNCHANGED entered_lock
  /\ UNCHANGED pc_watch
  /\ UNCHANGED entered_watch
  /\ doorClosed' \in BOOLEAN
  /\ UNCHANGED motorOn
  /\ UNCHANGED <<fn_isSafe>>
Step_watch_Alarm ==
  \/ Run_watch_Alarm
  \/ Fire1_watch_Alarm
  \/ Yield_watch_Alarm
Halt ==
  /\ Halted
  /\ UNCHANGED vars
Next ==
  \/ Step_lock_Idle
  \/ Step_lock_Running
  \/ Step_lock_Halting
  \/ Step_watch_Quiet
  \/ Step_watch_Alarm
  \/ Halt
Spec == Init /\ [][Next]_vars
=============================================================================
