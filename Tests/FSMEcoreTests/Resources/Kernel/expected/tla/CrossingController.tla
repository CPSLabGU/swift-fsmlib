---------------------------- MODULE CrossingController ----------------------------
\* Generated by the tla templates from the arrangement CrossingController.
EXTENDS Integers
CONSTANT MaxRounds
ASSUME MaxRounds \in Nat
VARIABLE turn
VARIABLE round
VARIABLE pc_main
VARIABLE entered_main
VARIABLE main_enteredAt
VARIABLE now
VARIABLE request
vars == <<turn, round, pc_main, entered_main, main_enteredAt, now, request>>
TypeOK ==
  /\ turn \in 0..0
  /\ round \in 0..MaxRounds
  /\ pc_main \in {"Go", "Go_x0", "Amber", "Stop"}
  /\ entered_main \in BOOLEAN
  /\ main_enteredAt \in 0..10000
  /\ now \in 0..10000
  /\ request \in BOOLEAN
Range_main_enteredAt == main_enteredAt \in 0..10000
Range_now == now \in 0..10000
Init ==
  /\ turn = 0
  /\ round = 0
  /\ pc_main = "Go"
  /\ entered_main = TRUE
  /\ main_enteredAt = 0
  /\ now \in 0..10000
  /\ request \in BOOLEAN
Halted ==
  /\ turn = 0
  /\ pc_main \in {}
  /\ ~entered_main
Run_main_Go ==
  /\ turn = 0
  /\ pc_main = "Go"
  /\ entered_main
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_main
  /\ entered_main' = FALSE
  /\ main_enteredAt' = now
  /\ UNCHANGED now
  /\ UNCHANGED request
Chain1_main_Go ==
  /\ turn = 0
  /\ pc_main = "Go"
  /\ ~entered_main
  /\ request
  /\ UNCHANGED <<turn, round>>
  /\ pc_main' = "Go_x0"
  /\ entered_main' = TRUE
  /\ UNCHANGED main_enteredAt
  /\ UNCHANGED now
  /\ UNCHANGED request
Yield_main_Go ==
  /\ turn = 0
  /\ pc_main = "Go"
  /\ ~entered_main
  /\ ~request
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_main
  /\ UNCHANGED entered_main
  /\ UNCHANGED main_enteredAt
  /\ now' \in 0..10000
  /\ request' \in BOOLEAN
Step_main_Go ==
  \/ Run_main_Go
  \/ Chain1_main_Go
  \/ Yield_main_Go
Run_main_Go_x0 ==
  /\ turn = 0
  /\ pc_main = "Go_x0"
  /\ entered_main
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_main
  /\ entered_main' = FALSE
  /\ UNCHANGED main_enteredAt
  /\ UNCHANGED now
  /\ UNCHANGED request
Fire1_main_Go_x0 ==
  /\ turn = 0
  /\ pc_main = "Go_x0"
  /\ ~entered_main
  /\ TRUE
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ pc_main' = "Amber"
  /\ entered_main' = TRUE
  /\ UNCHANGED main_enteredAt
  /\ now' \in 0..10000
  /\ request' \in BOOLEAN
Yield_main_Go_x0 ==
  /\ turn = 0
  /\ pc_main = "Go_x0"
  /\ ~entered_main
  /\ ~TRUE
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_main
  /\ UNCHANGED entered_main
  /\ UNCHANGED main_enteredAt
  /\ now' \in 0..10000
  /\ request' \in BOOLEAN
Step_main_Go_x0 ==
  \/ Run_main_Go_x0
  \/ Fire1_main_Go_x0
  \/ Yield_main_Go_x0
Run_main_Amber ==
  /\ turn = 0
  /\ pc_main = "Amber"
  /\ entered_main
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_main
  /\ entered_main' = FALSE
  /\ main_enteredAt' = now
  /\ UNCHANGED now
  /\ UNCHANGED request
Fire1_main_Amber ==
  /\ turn = 0
  /\ pc_main = "Amber"
  /\ ~entered_main
  /\ ((now - main_enteredAt) >= 3)
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ pc_main' = "Stop"
  /\ entered_main' = TRUE
  /\ UNCHANGED main_enteredAt
  /\ now' \in 0..10000
  /\ request' \in BOOLEAN
Yield_main_Amber ==
  /\ turn = 0
  /\ pc_main = "Amber"
  /\ ~entered_main
  /\ ~((now - main_enteredAt) >= 3)
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_main
  /\ UNCHANGED entered_main
  /\ UNCHANGED main_enteredAt
  /\ now' \in 0..10000
  /\ request' \in BOOLEAN
Step_main_Amber ==
  \/ Run_main_Amber
  \/ Fire1_main_Amber
  \/ Yield_main_Amber
Run_main_Stop ==
  /\ turn = 0
  /\ pc_main = "Stop"
  /\ entered_main
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_main
  /\ entered_main' = FALSE
  /\ main_enteredAt' = now
  /\ UNCHANGED now
  /\ UNCHANGED request
Fire1_main_Stop ==
  /\ turn = 0
  /\ pc_main = "Stop"
  /\ ~entered_main
  /\ ((now - main_enteredAt) >= 5)
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ pc_main' = "Go"
  /\ entered_main' = TRUE
  /\ UNCHANGED main_enteredAt
  /\ now' \in 0..10000
  /\ request' \in BOOLEAN
Yield_main_Stop ==
  /\ turn = 0
  /\ pc_main = "Stop"
  /\ ~entered_main
  /\ ~((now - main_enteredAt) >= 5)
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_main
  /\ UNCHANGED entered_main
  /\ UNCHANGED main_enteredAt
  /\ now' \in 0..10000
  /\ request' \in BOOLEAN
Step_main_Stop ==
  \/ Run_main_Stop
  \/ Fire1_main_Stop
  \/ Yield_main_Stop
Halt ==
  /\ Halted
  /\ UNCHANGED vars
Next ==
  \/ Step_main_Go
  \/ Step_main_Go_x0
  \/ Step_main_Amber
  \/ Step_main_Stop
  \/ Halt
Spec == Init /\ [][Next]_vars
=============================================================================
