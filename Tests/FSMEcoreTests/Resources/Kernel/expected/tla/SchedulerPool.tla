---------------------------- MODULE SchedulerPool ----------------------------
\* Generated by the tla templates from the arrangement SchedulerPool.
EXTENDS Integers
CONSTANT MaxRounds
ASSUME MaxRounds \in Nat
VARIABLE turn
VARIABLE round
VARIABLE pc_gate
VARIABLE entered_gate
VARIABLE pc_first
VARIABLE entered_first
VARIABLE first_id
VARIABLE pc_second
VARIABLE entered_second
VARIABLE second_id
VARIABLE pc_third
VARIABLE entered_third
VARIABLE third_id
VARIABLE current
VARIABLE done
vars == <<turn, round, pc_gate, entered_gate, pc_first, entered_first, first_id, pc_second, entered_second, second_id, pc_third, entered_third, third_id, current, done>>
TypeOK ==
  /\ turn \in 0..3
  /\ round \in 0..MaxRounds
  /\ pc_gate \in {"Dispatch", "Advance"}
  /\ entered_gate \in BOOLEAN
  /\ pc_first \in {"Ready", "Working"}
  /\ entered_first \in BOOLEAN
  /\ first_id \in 0..2
  /\ pc_second \in {"Ready", "Working"}
  /\ entered_second \in BOOLEAN
  /\ second_id \in 0..2
  /\ pc_third \in {"Ready", "Working"}
  /\ entered_third \in BOOLEAN
  /\ third_id \in 0..2
  /\ current \in 0..2
  /\ done \in [0..2 -> BOOLEAN]
Range_first_id == first_id \in 0..2
Range_second_id == second_id \in 0..2
Range_third_id == third_id \in 0..2
Range_current == current \in 0..2
Init ==
  /\ turn = 0
  /\ round = 0
  /\ pc_gate = "Dispatch"
  /\ entered_gate = TRUE
  /\ pc_first = "Ready"
  /\ entered_first = TRUE
  /\ first_id = 0
  /\ pc_second = "Ready"
  /\ entered_second = TRUE
  /\ second_id = 1
  /\ pc_third = "Ready"
  /\ entered_third = TRUE
  /\ third_id = 2
  /\ current = 0
  /\ done = [k \in 0..2 |-> FALSE]
Halted ==
  /\ turn = 0
  /\ pc_gate \in {}
  /\ ~entered_gate
  /\ pc_first \in {}
  /\ ~entered_first
  /\ pc_second \in {}
  /\ ~entered_second
  /\ pc_third \in {}
  /\ ~entered_third
Run_gate_Dispatch ==
  /\ turn = 0
  /\ pc_gate = "Dispatch"
  /\ entered_gate
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_gate
  /\ entered_gate' = FALSE
  /\ UNCHANGED pc_first
  /\ UNCHANGED entered_first
  /\ UNCHANGED first_id
  /\ UNCHANGED pc_second
  /\ UNCHANGED entered_second
  /\ UNCHANGED second_id
  /\ UNCHANGED pc_third
  /\ UNCHANGED entered_third
  /\ UNCHANGED third_id
  /\ UNCHANGED current
  /\ UNCHANGED done
Chain1_gate_Dispatch ==
  /\ turn = 0
  /\ pc_gate = "Dispatch"
  /\ ~entered_gate
  /\ done[current]
  /\ UNCHANGED <<turn, round>>
  /\ pc_gate' = "Advance"
  /\ entered_gate' = TRUE
  /\ UNCHANGED pc_first
  /\ UNCHANGED entered_first
  /\ UNCHANGED first_id
  /\ UNCHANGED pc_second
  /\ UNCHANGED entered_second
  /\ UNCHANGED second_id
  /\ UNCHANGED pc_third
  /\ UNCHANGED entered_third
  /\ UNCHANGED third_id
  /\ UNCHANGED current
  /\ UNCHANGED done
Yield_gate_Dispatch ==
  /\ turn = 0
  /\ pc_gate = "Dispatch"
  /\ ~entered_gate
  /\ ~done[current]
  /\ ~Halted
  /\ turn' = 1
  /\ UNCHANGED round
  /\ UNCHANGED pc_gate
  /\ UNCHANGED entered_gate
  /\ UNCHANGED pc_first
  /\ UNCHANGED entered_first
  /\ UNCHANGED first_id
  /\ UNCHANGED pc_second
  /\ UNCHANGED entered_second
  /\ UNCHANGED second_id
  /\ UNCHANGED pc_third
  /\ UNCHANGED entered_third
  /\ UNCHANGED third_id
  /\ UNCHANGED current
  /\ UNCHANGED done
Step_gate_Dispatch ==
  \/ Run_gate_Dispatch
  \/ Chain1_gate_Dispatch
  \/ Yield_gate_Dispatch
Run_gate_Advance ==
  /\ turn = 0
  /\ pc_gate = "Advance"
  /\ entered_gate
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_gate
  /\ entered_gate' = FALSE
  /\ UNCHANGED pc_first
  /\ UNCHANGED entered_first
  /\ UNCHANGED first_id
  /\ UNCHANGED pc_second
  /\ UNCHANGED entered_second
  /\ UNCHANGED second_id
  /\ UNCHANGED pc_third
  /\ UNCHANGED entered_third
  /\ UNCHANGED third_id
  /\ current' = ((current + 1) % 3)
  /\ UNCHANGED done
Fire1_gate_Advance ==
  /\ turn = 0
  /\ pc_gate = "Advance"
  /\ ~entered_gate
  /\ TRUE
  /\ turn' = 1
  /\ UNCHANGED round
  /\ pc_gate' = "Dispatch"
  /\ entered_gate' = TRUE
  /\ UNCHANGED pc_first
  /\ UNCHANGED entered_first
  /\ UNCHANGED first_id
  /\ UNCHANGED pc_second
  /\ UNCHANGED entered_second
  /\ UNCHANGED second_id
  /\ UNCHANGED pc_third
