  /\ turn = 0
  /\ pc_gate = "Advance"
  /\ ~entered_gate
  /\ ~TRUE
  /\ ~Halted
  /\ turn' = 1
  /\ UNCHANGED round
  /\ UNCHANGED pc_gate
  /\ UNCHANGED entered_gate
  /\ UNCHANGED pc_first
  /\ UNCHANGED entered_first
  /\ UNCHANGED first_id
  /\ UNCHANGED pc_second
