-- Generated by the smv templates from the arrangement CrossingController.

MODULE RoundRobin(advance)
VAR
turn : 0..0;
INIT
turn = 0
DEFINE
executing_0 := turn = 0;
executing_main_smv := executing_0;
TRANS
next(turn) = case
advance : (turn + 1) mod 1;
TRUE : turn;
esac

MODULE Environment(advance)
VAR
now : 0..10000;
request : boolean;
TRANS
advance | (next(now) = now)
TRANS
advance | (next(request) = request)

MODULE Crossing(executing, now, request)
VAR
pc : {Go, Go_x0, Amber, Stop};
entered : boolean;
enteredAt : 0..10000;
INIT
pc = Go & entered
DEFINE
accepting := FALSE;
t1_Go_Go_x0 := executing & !entered & pc = Go & request;
t2_Go_x0_Amber := executing & !entered & pc = Go_x0 & TRUE;
t3_Amber_Stop := executing & !entered & pc = Amber & ((now - enteredAt) >= 3);
t4_Stop_Go := executing & !entered & pc = Stop & ((now - enteredAt) >= 5);
none := executing & !entered & !(t1_Go_Go_x0 | t2_Go_x0_Amber | t3_Amber_Stop | t4_Stop_Go);
advance := (executing & entered & accepting) | none | t2_Go_x0_Amber | t3_Amber_Stop | t4_Stop_Go;
TRANS
case
!executing : next(pc) = pc & next(entered) = entered & next(enteredAt) = enteredAt;
entered & pc = Go : next(pc) = pc & next(entered) = FALSE & next(enteredAt) = now;
entered & pc = Go_x0 : next(pc) = pc & next(entered) = FALSE & next(enteredAt) = enteredAt;
entered & pc = Amber : next(pc) = pc & next(entered) = FALSE & next(enteredAt) = now;
entered & pc = Stop : next(pc) = pc & next(entered) = FALSE & next(enteredAt) = now;
t1_Go_Go_x0 : next(pc) = Go_x0 & next(entered) = TRUE & next(enteredAt) = enteredAt;
t2_Go_x0_Amber : next(pc) = Amber & next(entered) = TRUE & next(enteredAt) = enteredAt;
t3_Amber_Stop : next(pc) = Stop & next(entered) = TRUE & next(enteredAt) = enteredAt;
t4_Stop_Go : next(pc) = Go & next(entered) = TRUE & next(enteredAt) = enteredAt;
TRUE : next(pc) = pc & next(entered) = entered & next(enteredAt) = enteredAt;
esac

MODULE main
VAR
sch : RoundRobin(advance);
env : Environment(advance);
main_smv : Crossing(sch.executing_0, env.now, env.request);
INIT
main_smv.enteredAt = 0
DEFINE
advance := main_smv.advance;
halted := main_smv.accepting & !(main_smv.entered);
INVARSPEC
main_smv.enteredAt >= 0 & main_smv.enteredAt <= 10000
