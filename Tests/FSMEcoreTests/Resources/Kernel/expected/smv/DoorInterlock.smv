-- Generated by the smv templates from the arrangement DoorInterlock.

MODULE RoundRobin(advance)
VAR
turn : 0..1;
INIT
turn = 0
DEFINE
executing_0 := turn = 0;
executing_1 := turn = 1;
executing_lock := executing_0;
executing_watch := executing_1;
TRANS
next(turn) = case
advance : (turn + 1) mod 2;
TRUE : turn;
esac

MODULE Environment(advance)
VAR
doorClosed : boolean;
TRANS
advance | (next(doorClosed) = doorClosed)

MODULE Shared(turn)
VAR
motorOn : boolean;
TRANS
!(turn in {0}) -> (next(motorOn) = motorOn)

MODULE Functions
FROZENVAR
isSafe : array 0..1 of boolean;

MODULE Interlock(executing, doorClosed, motorOn, fn)
VAR
pc : {Idle, Running, Halting};
entered : boolean;
INIT
pc = Idle & entered
DEFINE
accepting := FALSE;
t1_Idle_Running := executing & !entered & pc = Idle & fn.isSafe[toint(doorClosed)];
t2_Running_Halting := executing & !entered & pc = Running & (!doorClosed);
t3_Halting_Idle := executing & !entered & pc = Halting & TRUE;
none := executing & !entered & !(t1_Idle_Running | t2_Running_Halting | t3_Halting_Idle);
advance := (executing & entered & accepting) | none | t1_Idle_Running | t3_Halting_Idle;
TRANS
case
!executing : next(pc) = pc & next(entered) = entered;
entered & pc = Idle : next(pc) = pc & next(entered) = FALSE & next(motorOn) = motorOn;
entered & pc = Running : next(pc) = pc & next(entered) = FALSE & next(motorOn) = TRUE;
entered & pc = Halting : next(pc) = pc & next(entered) = FALSE & next(motorOn) = FALSE;
t1_Idle_Running : next(pc) = Running & next(entered) = TRUE & next(motorOn) = motorOn;
t2_Running_Halting : next(pc) = Halting & next(entered) = TRUE & next(motorOn) = motorOn;
t3_Halting_Idle : next(pc) = Idle & next(entered) = TRUE & next(motorOn) = motorOn;
TRUE : next(pc) = pc & next(entered) = entered & next(motorOn) = motorOn;
esac

MODULE Monitor(executing, doorClosed, lock)
VAR
pc : {Quiet, Alarm};
entered : boolean;
INIT
pc = Quiet & entered
DEFINE
accepting := FALSE;
t1_Quiet_Alarm := executing & !entered & pc = Quiet & ((lock.pc = Running) & (!doorClosed));
t2_Alarm_Quiet := executing & !entered & pc = Alarm & (lock.pc = Idle);
none := executing & !entered & !(t1_Quiet_Alarm | t2_Alarm_Quiet);
advance := (executing & entered & accepting) | none | t1_Quiet_Alarm | t2_Alarm_Quiet;
TRANS
case
!executing : next(pc) = pc & next(entered) = entered;
entered & pc = Quiet : next(pc) = pc & next(entered) = FALSE;
entered & pc = Alarm : next(pc) = pc & next(entered) = FALSE;
t1_Quiet_Alarm : next(pc) = Alarm & next(entered) = TRUE;
t2_Alarm_Quiet : next(pc) = Quiet & next(entered) = TRUE;
TRUE : next(pc) = pc & next(entered) = entered;
esac

MODULE main
VAR
sch : RoundRobin(advance);
env : Environment(advance);
shared : Shared(sch.turn);
fn : Functions;
lock : Interlock(sch.executing_0, env.doorClosed, shared.motorOn, fn);
watch : Monitor(sch.executing_1, env.doorClosed, lock);
INIT
shared.motorOn = FALSE
DEFINE
advance := lock.advance | watch.advance;
halted := lock.accepting & !(lock.entered) & watch.accepting & !(watch.entered);
