-- Generated by the smv templates from the arrangement SchedulerPool.

MODULE RoundRobin(advance)
VAR
turn : 0..3;
INIT
turn = 0
DEFINE
executing_0 := turn = 0;
executing_1 := turn = 1;
executing_2 := turn = 2;
executing_3 := turn = 3;
executing_gate := executing_0;
executing_first := executing_1;
executing_second := executing_2;
executing_third := executing_3;
TRANS
next(turn) = case
advance : (turn + 1) mod 4;
TRUE : turn;
esac

MODULE Shared(turn)
VAR
current : 0..2;
done : array 0..2 of boolean;
TRANS
!(turn in {0}) -> (next(current) = current)
TRANS
!(turn in {1, 2, 3}) -> (next(done[0]) = done[0] & next(done[1]) = done[1] & next(done[2]) = done[2])

MODULE Scheduler(executing, current, done)
VAR
pc : {Dispatch, Advance};
entered : boolean;
INIT
pc = Dispatch & entered
DEFINE
accepting := FALSE;
t1_Dispatch_Advance := executing & !entered & pc = Dispatch & done[current];
t2_Advance_Dispatch := executing & !entered & pc = Advance & TRUE;
none := executing & !entered & !(t1_Dispatch_Advance | t2_Advance_Dispatch);
advance := (executing & entered & accepting) | none | t2_Advance_Dispatch;
TRANS
case
!executing : next(pc) = pc & next(entered) = entered;
entered & pc = Dispatch : next(pc) = pc & next(entered) = FALSE & next(current) = current;
entered & pc = Advance : next(pc) = pc & next(entered) = FALSE & next(current) = ((current + 1) mod 3);
t1_Dispatch_Advance : next(pc) = Advance & next(entered) = TRUE & next(current) = current;
t2_Advance_Dispatch : next(pc) = Dispatch & next(entered) = TRUE & next(current) = current;
TRUE : next(pc) = pc & next(entered) = entered & next(current) = current;
esac

MODULE Worker(executing, current, done, gate)
VAR
pc : {Ready, Working};
entered : boolean;
id : 0..2;
INIT
pc = Ready & entered
DEFINE
accepting := FALSE;
t1_Ready_Working := executing & !entered & pc = Ready & ((gate.pc = Dispatch) & (current = id));
t2_Working_Ready := executing & !entered & pc = Working & (current != id);
none := executing & !entered & !(t1_Ready_Working | t2_Working_Ready);
advance := (executing & entered & accepting) | none | t1_Ready_Working | t2_Working_Ready;
TRANS
case
!executing : next(pc) = pc & next(entered) = entered & next(id) = id;
entered & pc = Ready : next(pc) = pc & next(entered) = FALSE & next(done[0]) = (case id = 0 : FALSE; TRUE : done[0]; esac) & next(done[1]) = (case id = 1 : FALSE; TRUE : done[1]; esac) & next(done[2]) = (case id = 2 : FALSE; TRUE : done[2]; esac) & next(id) = id;
entered & pc = Working : next(pc) = pc & next(entered) = FALSE & next(done[0]) = (case id = 0 : TRUE; TRUE : done[0]; esac) & next(done[1]) = (case id = 1 : TRUE; TRUE : done[1]; esac) & next(done[2]) = (case id = 2 : TRUE; TRUE : done[2]; esac) & next(id) = id;
t1_Ready_Working : next(pc) = Working & next(entered) = TRUE & next(done[0]) = done[0] & next(done[1]) = done[1] & next(done[2]) = done[2] & next(id) = id;
t2_Working_Ready : next(pc) = Ready & next(entered) = TRUE & next(done[0]) = done[0] & next(done[1]) = done[1] & next(done[2]) = done[2] & next(id) = id;
TRUE : next(pc) = pc & next(entered) = entered & next(done[0]) = done[0] & next(done[1]) = done[1] & next(done[2]) = done[2] & next(id) = id;
esac

MODULE main
VAR
sch : RoundRobin(advance);
shared : Shared(sch.turn);
gate : Scheduler(sch.executing_0, shared.current, shared.done);
first : Worker(sch.executing_1, shared.current, shared.done, gate);
second : Worker(sch.executing_2, shared.current, shared.done, gate);
third : Worker(sch.executing_3, shared.current, shared.done, gate);
INIT
shared.current = 0
INIT
shared.done[0] = FALSE & shared.done[1] = FALSE & shared.done[2] = FALSE
INIT
first.id = 0
INIT
second.id = 1
INIT
third.id = 2
DEFINE
advance := gate.advance | first.advance | second.advance | third.advance;
halted := gate.accepting & !(gate.entered) & first.accepting & !(first.entered) & second.accepting & !(second.entered) & third.accepting & !(third.entered);
INVARSPEC
shared.current >= 0 & shared.current <= 2
INVARSPEC
first.id >= 0 & first.id <= 2
INVARSPEC
second.id >= 0 & second.id <= 2
INVARSPEC
third.id >= 0 & third.id <= 2
