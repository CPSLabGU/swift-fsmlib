-- Generated by the smv templates from the arrangement TurnTakingRelay.

MODULE RoundRobin(advance)
VAR
turn : 0..1;
INIT
turn = 0
DEFINE
executing_0 := turn = 0;
executing_1 := turn = 1;
executing_leftHand := executing_0;
executing_rightHand := executing_1;
TRANS
next(turn) = case
advance : (turn + 1) mod 2;
TRUE : turn;
esac

MODULE Shared(turn)
VAR
turn_smv : {left, right};
TRANS
!(turn in {0, 1}) -> (next(turn_smv) = turn_smv)

MODULE Relay(executing, turn_smv)
VAR
pc : {Waiting, Holding, Passing};
entered : boolean;
me : {left, right};
passes : 0..9;
INIT
pc = Waiting & entered
DEFINE
accepting := FALSE;
t1_Waiting_Holding := executing & !entered & pc = Waiting & (turn_smv = me);
t2_Holding_Passing := executing & !entered & pc = Holding & (passes < 9);
t3_Passing_Waiting := executing & !entered & pc = Passing & TRUE;
none := executing & !entered & !(t1_Waiting_Holding | t2_Holding_Passing | t3_Passing_Waiting);
advance := (executing & entered & accepting) | none | t1_Waiting_Holding | t3_Passing_Waiting;
TRANS
case
!executing : next(pc) = pc & next(entered) = entered & next(me) = me & next(passes) = passes;
entered & pc = Waiting : next(pc) = pc & next(entered) = FALSE & next(turn_smv) = turn_smv & next(me) = me & next(passes) = passes;
entered & pc = Holding : next(pc) = pc & next(entered) = FALSE & next(turn_smv) = turn_smv & next(me) = me & next(passes) = passes;
entered & pc = Passing : next(pc) = pc & next(entered) = FALSE & next(turn_smv) = (case (me = left) : right; TRUE : left; esac) & next(me) = me & next(passes) = (passes + 1);
t1_Waiting_Holding : next(pc) = Holding & next(entered) = TRUE & next(turn_smv) = turn_smv & next(me) = me & next(passes) = passes;
t2_Holding_Passing : next(pc) = Passing & next(entered) = TRUE & next(turn_smv) = turn_smv & next(me) = me & next(passes) = passes;
t3_Passing_Waiting : next(pc) = Waiting & next(entered) = TRUE & next(turn_smv) = turn_smv & next(me) = me & next(passes) = passes;
TRUE : next(pc) = pc & next(entered) = entered & next(turn_smv) = turn_smv & next(me) = me & next(passes) = passes;
esac

MODULE main
VAR
sch : RoundRobin(advance);
shared : Shared(sch.turn);
leftHand : Relay(sch.executing_0, shared.turn_smv);
rightHand : Relay(sch.executing_1, shared.turn_smv);
INIT
shared.turn_smv = left
INIT
leftHand.me = left
INIT
leftHand.passes = 0
INIT
rightHand.me = right
INIT
rightHand.passes = 0
DEFINE
advance := leftHand.advance | rightHand.advance;
halted := leftHand.accepting & !(leftHand.entered) & rightHand.accepting & !(rightHand.entered);
INVARSPEC
leftHand.passes >= 0 & leftHand.passes <= 9
INVARSPEC
rightHand.passes >= 0 & rightHand.passes <= 9
