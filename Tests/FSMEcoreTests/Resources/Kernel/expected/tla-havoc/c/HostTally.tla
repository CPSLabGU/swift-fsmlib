---------------------------- MODULE HostTally ----------------------------
\* Generated by the tla templates from the arrangement HostTally.
\* WARNING: generated with opaque=havoc: opaque values and calls that cannot be represented are unconstrained, and opaque statements do nothing.
EXTENDS Integers
CONSTANT MaxRounds
ASSUME MaxRounds \in Nat
VARIABLE turn
VARIABLE round
VARIABLE pc_counter
VARIABLE entered_counter
VARIABLE counter_n
VARIABLE fn_isEven
vars == <<turn, round, pc_counter, entered_counter, counter_n, fn_isEven>>
TypeOK ==
  /\ turn \in 0..0
  /\ round \in 0..MaxRounds
  /\ pc_counter \in {"Start", "Work", "Pause", "Done"}
  /\ entered_counter \in BOOLEAN
  /\ counter_n \in 0..9
  /\ fn_isEven \in [0..9 -> BOOLEAN]
Range_counter_n == counter_n \in 0..9
Init ==
  /\ turn = 0
  /\ round = 0
  /\ pc_counter = "Start"
  /\ entered_counter = TRUE
  /\ counter_n = 0
  /\ fn_isEven \in [0..9 -> BOOLEAN]
Halted ==
  /\ turn = 0
  /\ pc_counter \in {"Done"}
  /\ ~entered_counter
Run_counter_Start ==
  /\ turn = 0
  /\ pc_counter = "Start"
  /\ entered_counter
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_counter
  /\ entered_counter' = FALSE
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Fire1_counter_Start ==
  /\ turn = 0
  /\ pc_counter = "Start"
  /\ ~entered_counter
  /\ TRUE
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ pc_counter' = "Work"
  /\ entered_counter' = TRUE
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Yield_counter_Start ==
  /\ turn = 0
  /\ pc_counter = "Start"
  /\ ~entered_counter
  /\ ~TRUE
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_counter
  /\ UNCHANGED entered_counter
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Step_counter_Start ==
  \/ Run_counter_Start
  \/ Fire1_counter_Start
  \/ Yield_counter_Start
Run_counter_Work(opaque1) ==
  /\ turn = 0
  /\ pc_counter = "Work"
  /\ entered_counter
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_counter
  /\ entered_counter' = FALSE
  /\ counter_n' = (counter_n + 1)
  /\ UNCHANGED <<fn_isEven>>
Fire1_counter_Work(opaque1) ==
  /\ turn = 0
  /\ pc_counter = "Work"
  /\ ~entered_counter
  /\ opaque1
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ pc_counter' = "Done"
  /\ entered_counter' = TRUE
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Chain2_counter_Work(opaque1) ==
  /\ turn = 0
  /\ pc_counter = "Work"
  /\ ~entered_counter
  /\ ~opaque1
  /\ fn_isEven[counter_n]
  /\ UNCHANGED <<turn, round>>
  /\ pc_counter' = "Pause"
  /\ entered_counter' = TRUE
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Fire3_counter_Work(opaque1) ==
  /\ turn = 0
  /\ pc_counter = "Work"
  /\ ~entered_counter
  /\ ~opaque1
  /\ ~fn_isEven[counter_n]
  /\ TRUE
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ pc_counter' = "Work"
  /\ entered_counter' = TRUE
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Yield_counter_Work(opaque1) ==
  /\ turn = 0
  /\ pc_counter = "Work"
  /\ ~entered_counter
  /\ ~opaque1
  /\ ~fn_isEven[counter_n]
  /\ ~TRUE
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_counter
  /\ UNCHANGED entered_counter
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Step_counter_Work ==
  \/ \E opaque1 \in BOOLEAN : Run_counter_Work(opaque1)
  \/ \E opaque1 \in BOOLEAN : Fire1_counter_Work(opaque1)
  \/ \E opaque1 \in BOOLEAN : Chain2_counter_Work(opaque1)
  \/ \E opaque1 \in BOOLEAN : Fire3_counter_Work(opaque1)
  \/ \E opaque1 \in BOOLEAN : Yield_counter_Work(opaque1)
Run_counter_Pause ==
  /\ turn = 0
  /\ pc_counter = "Pause"
  /\ entered_counter
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_counter
  /\ entered_counter' = FALSE
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Fire1_counter_Pause ==
  /\ turn = 0
  /\ pc_counter = "Pause"
  /\ ~entered_counter
  /\ TRUE
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ pc_counter' = "Work"
  /\ entered_counter' = TRUE
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Yield_counter_Pause ==
  /\ turn = 0
  /\ pc_counter = "Pause"
  /\ ~entered_counter
  /\ ~TRUE
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_counter
  /\ UNCHANGED entered_counter
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Step_counter_Pause ==
  \/ Run_counter_Pause
  \/ Fire1_counter_Pause
  \/ Yield_counter_Pause
Finish_counter_Done ==
  /\ turn = 0
  /\ pc_counter = "Done"
  /\ entered_counter
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_counter
  /\ entered_counter' = FALSE
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Yield_counter_Done ==
  /\ turn = 0
  /\ pc_counter = "Done"
  /\ ~entered_counter
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_counter
  /\ UNCHANGED entered_counter
  /\ UNCHANGED counter_n
  /\ UNCHANGED <<fn_isEven>>
Step_counter_Done ==
  \/ Finish_counter_Done
  \/ Yield_counter_Done
Halt ==
  /\ Halted
  /\ UNCHANGED vars
Next ==
  \/ Step_counter_Start
  \/ Step_counter_Work
  \/ Step_counter_Pause
  \/ Step_counter_Done
  \/ Halt
Spec == Init /\ [][Next]_vars
=============================================================================
