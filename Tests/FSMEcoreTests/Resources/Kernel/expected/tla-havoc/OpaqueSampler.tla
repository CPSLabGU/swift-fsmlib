---------------------------- MODULE OpaqueSampler ----------------------------
\* Generated by the tla templates from the arrangement OpaqueSampler.
\* WARNING: generated with opaque=havoc: opaque values and calls that cannot be represented are unconstrained, and opaque statements do nothing.
EXTENDS Integers
CONSTANT MaxRounds
ASSUME MaxRounds \in Nat
VARIABLE turn
VARIABLE round
VARIABLE pc_probe
VARIABLE entered_probe
vars == <<turn, round, pc_probe, entered_probe>>
TypeOK ==
  /\ turn \in 0..0
  /\ round \in 0..MaxRounds
  /\ pc_probe \in {"Wait", "Sample"}
  /\ entered_probe \in BOOLEAN
Init ==
  /\ turn = 0
  /\ round = 0
  /\ pc_probe = "Wait"
  /\ entered_probe = TRUE
Halted ==
  /\ turn = 0
  /\ pc_probe \in {}
  /\ ~entered_probe
Run_probe_Wait(opaque1) ==
  /\ turn = 0
  /\ pc_probe = "Wait"
  /\ entered_probe
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_probe
  /\ entered_probe' = FALSE
Fire1_probe_Wait(opaque1) ==
  /\ turn = 0
  /\ pc_probe = "Wait"
  /\ ~entered_probe
  /\ opaque1
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ pc_probe' = "Sample"
  /\ entered_probe' = TRUE
Yield_probe_Wait(opaque1) ==
  /\ turn = 0
  /\ pc_probe = "Wait"
  /\ ~entered_probe
  /\ ~opaque1
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_probe
  /\ UNCHANGED entered_probe
Step_probe_Wait ==
  \/ \E opaque1 \in BOOLEAN : Run_probe_Wait(opaque1)
  \/ \E opaque1 \in BOOLEAN : Fire1_probe_Wait(opaque1)
  \/ \E opaque1 \in BOOLEAN : Yield_probe_Wait(opaque1)
Run_probe_Sample ==
  /\ turn = 0
  /\ pc_probe = "Sample"
  /\ entered_probe
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_probe
  /\ entered_probe' = FALSE
Fire1_probe_Sample ==
  /\ turn = 0
  /\ pc_probe = "Sample"
  /\ ~entered_probe
  /\ TRUE
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ pc_probe' = "Wait"
  /\ entered_probe' = TRUE
Yield_probe_Sample ==
  /\ turn = 0
  /\ pc_probe = "Sample"
  /\ ~entered_probe
  /\ ~TRUE
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_probe
  /\ UNCHANGED entered_probe
Step_probe_Sample ==
  \/ Run_probe_Sample
  \/ Fire1_probe_Sample
  \/ Yield_probe_Sample
Halt ==
  /\ Halted
  /\ UNCHANGED vars
Next ==
  \/ Step_probe_Wait
  \/ Step_probe_Sample
  \/ Halt
Spec == Init /\ [][Next]_vars
=============================================================================
