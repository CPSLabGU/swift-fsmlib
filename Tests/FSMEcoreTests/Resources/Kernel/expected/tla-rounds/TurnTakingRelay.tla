---------------------------- MODULE TurnTakingRelay ----------------------------
\* Generated by the tla templates from the arrangement TurnTakingRelay.
EXTENDS Integers
CONSTANT MaxRounds
ASSUME MaxRounds \in Nat
VARIABLE turn
VARIABLE round
VARIABLE pc_leftHand
VARIABLE entered_leftHand
VARIABLE leftHand_me
VARIABLE leftHand_passes
VARIABLE pc_rightHand
VARIABLE entered_rightHand
VARIABLE rightHand_me
VARIABLE rightHand_passes
VARIABLE turn_tla
vars == <<turn, round, pc_leftHand, entered_leftHand, leftHand_me, leftHand_passes, pc_rightHand, entered_rightHand, rightHand_me, rightHand_passes, turn_tla>>
TypeOK ==
  /\ turn \in 0..1
  /\ round \in 0..MaxRounds
  /\ pc_leftHand \in {"Waiting", "Holding", "Passing"}
  /\ entered_leftHand \in BOOLEAN
  /\ leftHand_me \in {"left", "right"}
  /\ leftHand_passes \in 0..9
  /\ pc_rightHand \in {"Waiting", "Holding", "Passing"}
  /\ entered_rightHand \in BOOLEAN
  /\ rightHand_me \in {"left", "right"}
  /\ rightHand_passes \in 0..9
  /\ turn_tla \in {"left", "right"}
Range_leftHand_passes == leftHand_passes \in 0..9
Range_rightHand_passes == rightHand_passes \in 0..9
Init ==
  /\ turn = 0
  /\ round = 0
  /\ pc_leftHand = "Waiting"
  /\ entered_leftHand = TRUE
  /\ leftHand_me = "left"
  /\ leftHand_passes = 0
  /\ pc_rightHand = "Waiting"
  /\ entered_rightHand = TRUE
  /\ rightHand_me = "right"
  /\ rightHand_passes = 0
  /\ turn_tla = "left"
Halted ==
  /\ turn = 0
  /\ pc_leftHand \in {}
  /\ ~entered_leftHand
  /\ pc_rightHand \in {}
  /\ ~entered_rightHand
Run_leftHand_Waiting ==
  /\ turn = 0
  /\ pc_leftHand = "Waiting"
  /\ entered_leftHand
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_leftHand
  /\ entered_leftHand' = FALSE
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Fire1_leftHand_Waiting ==
  /\ turn = 0
  /\ pc_leftHand = "Waiting"
  /\ ~entered_leftHand
  /\ (turn_tla = leftHand_me)
  /\ turn' = 1
  /\ UNCHANGED round
  /\ pc_leftHand' = "Holding"
  /\ entered_leftHand' = TRUE
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Yield_leftHand_Waiting ==
  /\ turn = 0
  /\ pc_leftHand = "Waiting"
  /\ ~entered_leftHand
  /\ ~(turn_tla = leftHand_me)
  /\ ~Halted
  /\ turn' = 1
  /\ UNCHANGED round
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Step_leftHand_Waiting ==
  \/ Run_leftHand_Waiting
  \/ Fire1_leftHand_Waiting
  \/ Yield_leftHand_Waiting
Run_leftHand_Holding ==
  /\ turn = 0
  /\ pc_leftHand = "Holding"
  /\ entered_leftHand
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_leftHand
  /\ entered_leftHand' = FALSE
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Chain1_leftHand_Holding ==
  /\ turn = 0
  /\ pc_leftHand = "Holding"
  /\ ~entered_leftHand
  /\ (leftHand_passes < 9)
  /\ UNCHANGED <<turn, round>>
  /\ pc_leftHand' = "Passing"
  /\ entered_leftHand' = TRUE
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Yield_leftHand_Holding ==
  /\ turn = 0
  /\ pc_leftHand = "Holding"
  /\ ~entered_leftHand
  /\ ~(leftHand_passes < 9)
  /\ ~Halted
  /\ turn' = 1
  /\ UNCHANGED round
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Step_leftHand_Holding ==
  \/ Run_leftHand_Holding
  \/ Chain1_leftHand_Holding
  \/ Yield_leftHand_Holding
Run_leftHand_Passing ==
  /\ turn = 0
  /\ pc_leftHand = "Passing"
  /\ entered_leftHand
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_leftHand
  /\ entered_leftHand' = FALSE
  /\ UNCHANGED leftHand_me
  /\ leftHand_passes' = (leftHand_passes + 1)
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ turn_tla' = (IF (leftHand_me = "left") THEN "right" ELSE "left")
Fire1_leftHand_Passing ==
  /\ turn = 0
  /\ pc_leftHand = "Passing"
  /\ ~entered_leftHand
  /\ TRUE
  /\ turn' = 1
  /\ UNCHANGED round
  /\ pc_leftHand' = "Waiting"
  /\ entered_leftHand' = TRUE
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Yield_leftHand_Passing ==
  /\ turn = 0
  /\ pc_leftHand = "Passing"
  /\ ~entered_leftHand
  /\ ~TRUE
  /\ ~Halted
  /\ turn' = 1
  /\ UNCHANGED round
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Step_leftHand_Passing ==
  \/ Run_leftHand_Passing
  \/ Fire1_leftHand_Passing
  \/ Yield_leftHand_Passing
Run_rightHand_Waiting ==
  /\ turn = 1
  /\ pc_rightHand = "Waiting"
  /\ entered_rightHand
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ entered_rightHand' = FALSE
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Fire1_rightHand_Waiting ==
  /\ turn = 1
  /\ pc_rightHand = "Waiting"
  /\ ~entered_rightHand
  /\ (turn_tla = rightHand_me)
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ pc_rightHand' = "Holding"
  /\ entered_rightHand' = TRUE
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Yield_rightHand_Waiting ==
  /\ turn = 1
  /\ pc_rightHand = "Waiting"
  /\ ~entered_rightHand
  /\ ~(turn_tla = rightHand_me)
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Step_rightHand_Waiting ==
  \/ Run_rightHand_Waiting
  \/ Fire1_rightHand_Waiting
  \/ Yield_rightHand_Waiting
Run_rightHand_Holding ==
  /\ turn = 1
  /\ pc_rightHand = "Holding"
  /\ entered_rightHand
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ entered_rightHand' = FALSE
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Chain1_rightHand_Holding ==
  /\ turn = 1
  /\ pc_rightHand = "Holding"
  /\ ~entered_rightHand
  /\ (rightHand_passes < 9)
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ pc_rightHand' = "Passing"
  /\ entered_rightHand' = TRUE
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Yield_rightHand_Holding ==
  /\ turn = 1
  /\ pc_rightHand = "Holding"
  /\ ~entered_rightHand
  /\ ~(rightHand_passes < 9)
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Step_rightHand_Holding ==
  \/ Run_rightHand_Holding
  \/ Chain1_rightHand_Holding
  \/ Yield_rightHand_Holding
Run_rightHand_Passing ==
  /\ turn = 1
  /\ pc_rightHand = "Passing"
  /\ entered_rightHand
  /\ UNCHANGED <<turn, round>>
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ entered_rightHand' = FALSE
  /\ UNCHANGED rightHand_me
  /\ rightHand_passes' = (rightHand_passes + 1)
  /\ turn_tla' = (IF (rightHand_me = "left") THEN "right" ELSE "left")
Fire1_rightHand_Passing ==
  /\ turn = 1
  /\ pc_rightHand = "Passing"
  /\ ~entered_rightHand
  /\ TRUE
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ pc_rightHand' = "Waiting"
  /\ entered_rightHand' = TRUE
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Yield_rightHand_Passing ==
  /\ turn = 1
  /\ pc_rightHand = "Passing"
  /\ ~entered_rightHand
  /\ ~TRUE
  /\ ~Halted
  /\ turn' = 0
  /\ round' = IF round < MaxRounds THEN round + 1 ELSE round
  /\ UNCHANGED pc_leftHand
  /\ UNCHANGED entered_leftHand
  /\ UNCHANGED leftHand_me
  /\ UNCHANGED leftHand_passes
  /\ UNCHANGED pc_rightHand
  /\ UNCHANGED entered_rightHand
  /\ UNCHANGED rightHand_me
  /\ UNCHANGED rightHand_passes
  /\ UNCHANGED turn_tla
Step_rightHand_Passing ==
  \/ Run_rightHand_Passing
  \/ Fire1_rightHand_Passing
  \/ Yield_rightHand_Passing
Halt ==
  /\ Halted
  /\ UNCHANGED vars
Next ==
  \/ Step_leftHand_Waiting
  \/ Step_leftHand_Holding
  \/ Step_leftHand_Passing
  \/ Step_rightHand_Waiting
  \/ Step_rightHand_Holding
  \/ Step_rightHand_Passing
  \/ Halt
Spec == Init /\ [][Next]_vars
=============================================================================
