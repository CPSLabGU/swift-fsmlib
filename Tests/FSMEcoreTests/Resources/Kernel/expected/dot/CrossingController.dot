digraph "CrossingController" {
  graph [rankdir=TB, fontname="Helvetica", fontsize=8, nodesep=0.3, ranksep=0.25, pad=0.03, margin=0];
  node [fontname="Helvetica", fontsize=8, margin="0.03,0.02"];
  edge [fontname="Helvetica", fontsize=7, arrowsize=0.6];
  subgraph "cluster_main" {
    label=<<I>main</I> : Crossing>;
    style="rounded,dashed"; color="#888888";
    "main.initial" [shape=circle, style=filled, fillcolor=black, label="", width=0.12, fixedsize=true];
    "main.Go" [shape=ellipse, style=solid, label=<<B>Go</B><BR/><I>entry of Go</I><BR/><FONT POINT-SIZE="6">enteredAt := now<BR/>print "go"</FONT>>];
    "main.Go_x0" [shape=ellipse, style=dashed, label=<<B>Go_x0</B><BR/><I>exit of Go, transition 0</I><BR/><FONT POINT-SIZE="6">print "clearing"</FONT>>];
    "main.Amber" [shape=ellipse, style=solid, label=<<B>Amber</B><BR/><I>entry of Amber</I><BR/><FONT POINT-SIZE="6">enteredAt := now<BR/>print "amber"</FONT>>];
    "main.Stop" [shape=ellipse, style=solid, label=<<B>Stop</B><BR/><I>entry of Stop</I><BR/><FONT POINT-SIZE="6">enteredAt := now<BR/>print "stop"</FONT>>];
    "main.initial" -> "main.Go";
    "main.Go" -> "main.Go_x0" [label=<1: request>];
    "main.Go_x0" -> "main.Amber" [label=<1: true>];
    "main.Amber" -> "main.Stop" [label=<1: ((now - enteredAt) &gt;= 3)>];
    "main.Stop" -> "main.Go" [label=<1: ((now - enteredAt) &gt;= 5)>];
  }
}
