-- Generated by the smv templates from the arrangement HostTally.
-- WARNING: generated with opaque=havoc: opaque values and calls that cannot be represented are unconstrained, and opaque statements do nothing.

MODULE RoundRobin(advance)
VAR
turn : 0..0;
INIT
turn = 0
DEFINE
executing_0 := turn = 0;
executing_counter := executing_0;
TRANS
next(turn) = case
advance : (turn + 1) mod 1;
TRUE : turn;
esac

MODULE Functions
FROZENVAR
isEven : array 0..9 of boolean;

MODULE Counter(executing, fn)
VAR
pc : {Start, Work, Pause, Done};
entered : boolean;
n : 0..9;
IVAR
opaque1 : boolean;
INIT
pc = Start & entered
DEFINE
accepting := pc = Done;
t1_Start_Work := executing & !entered & pc = Start & TRUE;
t2_Work_Done := executing & !entered & pc = Work & opaque1;
t3_Work_Pause := executing & !entered & pc = Work & !(t2_Work_Done) & fn.isEven[n];
t4_Work_Work := executing & !entered & pc = Work & !(t2_Work_Done) & !(t3_Work_Pause) & TRUE;
t5_Pause_Work := executing & !entered & pc = Pause & TRUE;
none := executing & !entered & !(t1_Start_Work | t2_Work_Done | t3_Work_Pause | t4_Work_Work | t5_Pause_Work);
advance := (executing & entered & accepting) | none | t1_Start_Work | t2_Work_Done | t4_Work_Work | t5_Pause_Work;
TRANS
case
!executing : next(pc) = pc & next(entered) = entered & next(n) = n;
entered & pc = Start : next(pc) = pc & next(entered) = FALSE & next(n) = n;
entered & pc = Work : next(pc) = pc & next(entered) = FALSE & next(n) = (n + 1);
entered & pc = Pause : next(pc) = pc & next(entered) = FALSE & next(n) = n;
entered & pc = Done : next(pc) = pc & next(entered) = FALSE & next(n) = n;
t1_Start_Work : next(pc) = Work & next(entered) = TRUE & next(n) = n;
t2_Work_Done : next(pc) = Done & next(entered) = TRUE & next(n) = n;
t3_Work_Pause : next(pc) = Pause & next(entered) = TRUE & next(n) = n;
t4_Work_Work : next(pc) = Work & next(entered) = TRUE & next(n) = n;
t5_Pause_Work : next(pc) = Work & next(entered) = TRUE & next(n) = n;
TRUE : next(pc) = pc & next(entered) = entered & next(n) = n;
esac

MODULE main
VAR
sch : RoundRobin(advance);
fn : Functions;
counter : Counter(sch.executing_0, fn);
INIT
counter.n = 0
DEFINE
advance := counter.advance;
halted := counter.accepting & !(counter.entered);
INVARSPEC
counter.n >= 0 & counter.n <= 9
