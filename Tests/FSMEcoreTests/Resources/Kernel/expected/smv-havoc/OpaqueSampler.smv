MODULE RoundRobin(advance)
VAR
turn : 0..0;
INIT
turn = 0
DEFINE
executing_0 := turn = 0;
executing_probe := executing_0;
TRANS
next(turn) = case
advance : (turn + 1) mod 1;
TRUE : turn;
esac

MODULE Sampler(executing)
VAR
pc : {Wait, Sample};
entered : boolean;
IVAR
opaque1 : boolean;
INIT
