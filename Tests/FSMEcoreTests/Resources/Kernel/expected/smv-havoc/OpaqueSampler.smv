TRANS
case
!executing : next(pc) = pc & next(entered) = entered;
entered & pc = Wait : next(pc) = pc & next(entered) = FALSE;
entered & pc = Sample : next(pc) = pc & next(entered) = FALSE;
t1_Wait_Sample : next(pc) = Sample & next(entered) = TRUE;
t2_Sample_Wait : next(pc) = Wait & next(entered) = TRUE;
TRUE : next(pc) = pc & next(entered) = entered;
esac

