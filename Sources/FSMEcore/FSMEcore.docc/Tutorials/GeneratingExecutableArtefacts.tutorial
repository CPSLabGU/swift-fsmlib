@Tutorial {
    @Intro(title: "Generate Executable Artefacts") {
        Learn how to encode a native machine as an executable LLFSM model and run one of the bundled legacy MTL templates against it.

        This path is intended for generator parity. It uses the executable metamodel so the template surface matches the legacy LLFSM model hierarchy while still starting from the native Swift machine value.
    }

    @Section(title: "Load The Executable Metamodel") {
        @ContentAndMedia {
            Start by loading the bundled executable metamodel and creating the template generator.
        }

        @Steps {
            @Step {
                Construct the metamodel and generator.

                ```swift
                import FSMEcore

                let metamodel = try await ExecutableLLFSMMetamodel()
                let generator = ExecutableTemplateGenerator(metamodel: metamodel)
                ```
            }
        }
    }

    @Section(title: "Run A Bundled Template") {
        @ContentAndMedia {
            The bundled templates are resolved by basename. Choose one of the executable templates, such as `llfsm2dot`, and generate into an output directory.
        }

        @Steps {
            @Step {
                Resolve the template and generate files.

                ```swift
                import Foundation
                import FSM

                let templateURL = try generator.bundledTemplateURL(named: "llfsm2dot")
                let outputDirectory = URL(fileURLWithPath: "Generated")

                try await generator.generate(
                    templateURL: templateURL,
                    machine: machine,
                    name: "Example",
                    outputDirectory: outputDirectory
                )
                ```
            }
        }
    }
}
