[comment]
C++20 execution target for kernel arrangements.

Generates <Arrangement>.cpp, a program that runs the arrangement round by
round and prints its canonical trace (see the C target for the trace and
the inputs format; the program takes the same arguments).

Host declarations for the language cpp come after the standard headers
and the typed kernel types; opaque types are aliases of their text, and
declared free functions get prototypes, so their implementations can come
from the host declarations or another translation unit. A value of an
opaque type is printed with operator<<.
[/comment]
[module generate('http://cpslabgu.github.io/llfsm/kernel')/]
[import expressions::kernel/]
[import expressions::cpp/]

[comment The external and the other shared variables. /]
[query public externals(a : Arrangement) : Sequence(Variable) = a.variables->select(v | v.external)/]
[query public sharedVariables(a : Arrangement) : Sequence(Variable) = a.variables->reject(v | v.external)/]

[comment The typed scalar types, declared before the host declarations. /]
[query public scalarTypes(a : Arrangement) : Sequence(Type) =
  a.types->select(t | t.oclIsKindOf(BooleanType) or t.oclIsKindOf(IntegerType) or t.oclIsKindOf(EnumerationType))/]

[comment The free functions of the arrangement and its machines, which get prototypes. /]
[query public freeFunctions(a : Arrangement) : Sequence(FunctionDeclaration) =
  a.eAllContents(FunctionDeclaration)->select(f | f.receiverType.oclIsUndefined())/]

[template public generate(a : Arrangement)]
[comment @main /]
[let problems = codeProblems(a, targetLanguage())]
[if (problems->notEmpty())]
[for (p : String | problems)]
error [p/]
[/for]
[else]
[program(a)/]
[/if]
[/let]
[/template]

[comment A statement that sets a variable, given as an lvalue, to a value (undefined for the default). /]
[template public initialise(lvalue : String, v : Variable, value : Expression)]
[if (v.type.oclIsKindOf(ArrayType))]
        [lvalue/].fill([defaultValue(v.type.oclAsType(ArrayType).element)/]);
[elseif (not value.oclIsUndefined())]
        [lvalue/] = [expr(value)/];
[elseif (not v.type.oclIsKindOf(OpaqueType))]
        [lvalue/] = [defaultValue(v.type)/];
[/if]
[/template]

[template public program(a : Arrangement)]
[file (a.name + '.cpp', false)]
// Generated by the kernel-cpp templates from the arrangement [a.name/].
#include <array>
#include <cerrno>
#include <climits>
#include <cstddef>
#include <cstdlib>
#include <fstream>
#include <iostream>
#include <sstream>
#include <string>
#include <string_view>
#include <vector>
[for (h : HostDeclarations | hostDeclarationsFor(a, targetLanguage()))]
[if (not h.includes.oclIsUndefined() and h.includes <> '')]
[h.includes/]
[/if]
[/for]

inline int llfsm_check(int value, int lower, int upper, const char *name)
{
    if (value < lower || value > upper) {
        std::cout.flush();
        std::cerr << "range violation " << name << '\n';
        std::exit(2);
    }
    return value;
}

inline std::size_t llfsm_index(int index, int size, const char *name)
{
    return static_cast<std::size_t>(llfsm_check(index, 0, size - 1, name));
}

inline void llfsm_print_bool(bool value)
{
    std::cout << (value ? "true" : "false");
}

inline void llfsm_print_int(int value)
{
    std::cout << value;
}
[for (t : Type | scalarTypes(a))]

[if (t.oclIsKindOf(BooleanType))]
using [t.name/] = bool;

inline bool llfsm_parse_[t.name/](const std::string &text, [t.name/] &out)
{
    if (text == "true" || text == "false") {
        out = text == "true";
        return true;
    }
    return false;
}
[elseif (t.oclIsKindOf(IntegerType))]
using [t.name/] = int;

inline bool llfsm_parse_[t.name/](const std::string &text, [t.name/] &out)
{
    char *end = nullptr;
    errno = 0;
    long value = std::strtol(text.c_str(), &end, 10);
    if (end == text.c_str() || *end != '\0' || errno != 0 || value < [t.oclAsType(IntegerType).lower/] || value > [t.oclAsType(IntegerType).upper/]) {
        return false;
    }
    out = static_cast<int>(value);
    return true;
}
[else]
enum class [t.name/] { [for (l : String | t.oclAsType(EnumerationType).literals) separator(', ')][l/][/for] };

inline std::string_view llfsm_name([t.name/] value)
{
    constexpr std::array<std::string_view, [t.oclAsType(EnumerationType).literals->size()/]> names{{ [for (l : String | t.oclAsType(EnumerationType).literals) separator(', ')]"[cppString(l)/]"[/for] }};
    return names['['/]static_cast<std::size_t>(value)[']'/];
}

inline void llfsm_print_[t.name/]([t.name/] value)
{
    std::cout << llfsm_name(value);
}

inline bool llfsm_parse_[t.name/](const std::string &text, [t.name/] &out)
{
    for (std::size_t k = 0; k < [t.oclAsType(EnumerationType).literals->size()/]; k++) {
        if (text == llfsm_name(static_cast<[t.name/]>(k))) {
            out = static_cast<[t.name/]>(k);
            return true;
        }
    }
    return false;
}
[/if]
[/for]
[for (h : HostDeclarations | hostDeclarationsFor(a, targetLanguage()))]
[if (not h.declarations.oclIsUndefined() and h.declarations <> '')]

[h.declarations/]
[/if]
[/for]
[for (t : Type | a.types->select(x | x.oclIsKindOf(OpaqueType)))]

using [t.name/] = [t.oclAsType(OpaqueType).text/];
[/for]
[for (t : Type | a.types->select(x | x.oclIsKindOf(ArrayType)))]

using [t.name/] = std::array<[t.oclAsType(ArrayType).element.name/], [t.oclAsType(ArrayType).size/]>;
[/for]
[if (freeFunctions(a)->notEmpty())]

[for (f : FunctionDeclaration | freeFunctions(a))]
[if (f.result.oclIsUndefined())]void[else][f.result.name/][/if] [f.name/]([for (p : Parameter | f.parameters) separator(', ')][p.type.name/] [p.name/][/for]);
[/for]
[/if]
[if (externals(a)->notEmpty())]

struct llfsm_Environment {
[for (v : Variable | externals(a))]
    [v.type.name/] [v.name/]{};
[/for]
};
[/if]

class llfsm_Arrangement;
[for (m : Machine | a.machines)]

enum class [m.name/]_State { [for (s : State | m.states) separator(', ')][s.name/][/for] };

inline std::string_view llfsm_name([m.name/]_State state)
{
    constexpr std::array<std::string_view, [m.states->size()/]> names{{ [for (s : State | m.states) separator(', ')]"[cppString(s.name)/]"[/for] }};
    return names['['/]static_cast<std::size_t>(state)[']'/];
}

inline bool llfsm_is_accepting([m.name/]_State state)
{
    constexpr std::array<bool, [m.states->size()/]> flags{{ [for (s : State | m.states) separator(', ')][if (isAccepting(s))]true[else]false[/if][/for] }};
    return flags['['/]static_cast<std::size_t>(state)[']'/];
}

inline bool llfsm_is_pass_through([m.name/]_State state)
{
    constexpr std::array<bool, [m.states->size()/]> flags{{ [for (s : State | m.states) separator(', ')][if (s.passThrough)]true[else]false[/if][/for] }};
    return flags['['/]static_cast<std::size_t>(state)[']'/];
}

struct [m.name/]_Machine {
    [m.name/]_State llfsm_pc = [m.name/]_State::[m.initial.name/];
    bool llfsm_entered = true;
[for (v : Variable | m.variables)]
    [v.type.name/] [v.name/]{};
[/for]

    void llfsm_ringlet(llfsm_Arrangement &llfsm_arrangement);
};
[/for]

class llfsm_Arrangement {
public:
[for (v : Variable | sharedVariables(a))]
    [v.type.name/] [v.name/]{};
[/for]
[if (externals(a)->notEmpty())]
    llfsm_Environment llfsm_environment;
[/if]
[for (inst : Instance | a.instances)]
    [inst.machine.name/]_Machine llfsm_instance_[inst.name/];
[/for]

    llfsm_Arrangement()
    {
[for (v : Variable | sharedVariables(a))]
[initialise(v.name, v, v.initialValue)/]
[/for]
[for (v : Variable | externals(a))]
[initialise('llfsm_environment.' + v.name, v, v.initialValue)/]
[/for]
[for (inst : Instance | a.instances)]
[for (v : Variable | inst.machine.variables)]
[initialise('llfsm_instance_' + inst.name + '.' + v.name, v, initialExpression(inst, v))/]
[/for]
[/for]
    }

    bool llfsm_set_external(const std::string &key, bool indexed, int index, const std::string &value)
    {
        (void)key;
        (void)indexed;
        (void)index;
        (void)value;
[for (v : Variable | externals(a))]
        if (key == "[cppString(v.name)/]") {
[if (v.type.oclIsKindOf(ArrayType))]
            return indexed && index >= 0 && index < [v.type.oclAsType(ArrayType).size/] && llfsm_parse_[v.type.oclAsType(ArrayType).element.name/](value, llfsm_environment.[v.name/]['['/]static_cast<std::size_t>(index)[']'/]);
[else]
            return !indexed && llfsm_parse_[v.type.name/](value, llfsm_environment.[v.name/]);
[/if]
        }
[/for]
        return false;
    }

    bool llfsm_apply_assignment(std::string token)
    {
        std::size_t equals = token.find('=');
        if (equals == std::string::npos) {
            return false;
        }
        std::string value = token.substr(equals + 1);
        token.erase(equals);
        bool indexed = false;
        int index = 0;
        std::size_t bracket = token.find('\x5b');
        if (bracket != std::string::npos) {
            const std::string position = token.substr(bracket + 1);
            std::size_t first = (!position.empty() && (position['['/]0[']'/] == '+' || position['['/]0[']'/] == '-')) ? 1 : 0;
            if (position.size() < first + 2 || position.back() != '\x5d'
                || position.find_first_not_of("0123456789", first) != position.size() - 1) {
                return false;
            }
            errno = 0;
            long parsed = std::strtol(position.c_str(), nullptr, 10);
            if (errno != 0 || parsed < INT_MIN || parsed > INT_MAX) {
                return false;
            }
            index = static_cast<int>(parsed);
            indexed = true;
            token.erase(bracket);
        }
        return llfsm_set_external(token, indexed, index, value);
    }

    bool llfsm_apply_inputs(const std::vector<std::string> &lines, int round)
    {
        for (const std::string &line : lines) {
            std::istringstream fields(line);
            long when = 0;
            if (!(fields >> when) || when != round) {
                continue;
            }
            std::string token;
            while (fields >> token) {
                if (!llfsm_apply_assignment(token)) {
                    std::cerr << "invalid input " << token << '\n';
                    return false;
                }
            }
        }
        return true;
    }

    int llfsm_run(int maxRounds, const std::vector<std::string> &inputLines)
    {
        std::cout << "arrangement [cppString(a.name)/]\n";
        for (int round = 1; ; round++) {
            if (!llfsm_apply_inputs(inputLines, round)) {
                return 1;
            }
[for (inst : Instance | a.instances)]
            llfsm_instance_[inst.name/].llfsm_ringlet(*this);
            std::cout << "R" << round << " [cppString(inst.name)/] " << llfsm_name(llfsm_instance_[inst.name/].llfsm_pc) << '\n';
[/for]
            if ([for (inst : Instance | a.instances) separator(' && ')]llfsm_is_accepting(llfsm_instance_[inst.name/].llfsm_pc) && !llfsm_instance_[inst.name/].llfsm_entered[/for]) {
                std::cout << "halt R" << round << '\n';
                break;
            }
            if (round == maxRounds) {
                break;
            }
        }
        return 0;
    }
};
[for (m : Machine | a.machines)]

void [m.name/]_Machine::llfsm_ringlet(llfsm_Arrangement &llfsm_arrangement)
{
[for (v : Variable | sharedVariables(a))]
    [v.type.name/] &[v.name/] = llfsm_arrangement.[v.name/];
[/for]
[for (v : Variable | externals(a))]
    const [v.type.name/] [v.name/] = llfsm_arrangement.llfsm_environment.[v.name/];
[/for]
    (void)llfsm_arrangement;
[for (v : Variable | a.variables)]
    (void)[v.name/];
[/for]
    for (;;) {
        if (llfsm_entered) {
            llfsm_entered = false;
            switch (llfsm_pc) {
[for (s : State | m.states->select(x | x.actions->notEmpty()))]
            case [m.name/]_State::[s.name/]:
[for (act : Statement | s.actions)]
[statement(act)/]
[/for]
                break;
[/for]
            default:
                break;
            }
        }
        bool llfsm_fired = true;
        switch (llfsm_pc) {
[for (s : State | m.states->reject(x | isAccepting(x)))]
        case [m.name/]_State::[s.name/]:
[for (t : Transition | s.transitions)]
            [if (i = 1)]if[else]} else if[/if] [condition(t.label)/] {
                llfsm_pc = [m.name/]_State::[t.target.name/];
[/for]
            } else {
                llfsm_fired = false;
            }
            break;
[/for]
        default:
            llfsm_fired = false;
            break;
        }
        if (!llfsm_fired) {
            return;
        }
        llfsm_entered = true;
        if (!llfsm_is_pass_through(llfsm_pc)) {
            return;
        }
    }
}
[/for]

int main(int argc, char **argv)
{
    int maxRounds = argc > 1 ? std::atoi(argv['['/]1[']'/]) : 20;
    std::vector<std::string> inputLines;
    if (argc > 2) {
        std::ifstream inputs(argv['['/]2[']'/]);
        if (!inputs) {
            std::cerr << "cannot open " << argv['['/]2[']'/] << '\n';
            return 1;
        }
        std::string line;
        while (std::getline(inputs, line)) {
            inputLines.push_back(line);
        }
    }
    llfsm_Arrangement arrangement;
    return arrangement.llfsm_run(maxRounds, inputLines);
}
[/file]
[/template]
