[comment]
nuXmv and NuSMV verification target for kernel arrangements.

A Kripke step is one micro-step of the instance whose turn it is: the
action of a state that was entered, or the evaluation of the labels of a
state that was not. External variables are frozen within a ringlet and
unconstrained when the turn advances, which realises one snapshot per
ringlet. Print, call and opaque statements do not change the model.

Parameters:
  maxRounds  bound of the saturating round counter; 0 (the default) emits no counter
  entry      ringlet (default): an action runs in its own micro-step at the start of
             the next ringlet; fused: it runs in the micro-step that enters the state
  sanity     true appends CTL properties: every state is reachable, every state with
             transitions can be left, every transition fires
  opaque     reject (default): opaque nodes and calls that cannot be represented are
             generation errors; havoc: they are unconstrained or ignored

Layout: RoundRobin (turn, executing_<k>, round), Environment (external
variables), Shared (shared variables, framed by the turns of the
instances that write them), Functions (one frozen table per pure
function), one module per machine, and main last, so that properties can
be appended to the file.
[/comment]
[module generate('http://cpslabgu.github.io/llfsm/kernel')/]
[import expressions::kernel/]
[import expressions::verification/]
[import expressions::smv/]

[comment Variables. /]
[query public externals(a : Arrangement) : Sequence(Variable) = a.variables->select(v | v.external and isModelledVariable(v))/]
[query public sharedVariables(a : Arrangement) : Sequence(Variable) = a.variables->select(v | not v.external and isModelledVariable(v))/]
[query public locals(m : Machine) : Sequence(Variable) = m.variables->select(v | isModelledVariable(v))/]
[query public isIntegerTyped(t : Type) : Boolean = scalarType(t).oclIsKindOf(IntegerType)/]

[comment The modelled assignments of a state to a variable. /]
[query public assignments(s : State, v : Variable) : Sequence(Assignment) = s.actions->filter(Assignment)->select(x | x.target.variable = v)/]

[comment The instances and machines that read, write and observe. /]
[query public turnOf(a : Arrangement, inst : Instance) : Integer = a.instances->indexOf(inst) - 1/]
[query public writes(m : Machine, v : Variable) : Boolean = m.eAllContents(Assignment)->exists(x | x.target.variable = v)/]
[query public writers(a : Arrangement, v : Variable) : Sequence(Instance) = a.instances->select(i | writes(i.machine, v))/]
[query public writtenShared(a : Arrangement, m : Machine) : Sequence(Variable) = sharedVariables(a)->select(v | writes(m, v))/]
[query public references(m : Machine, v : Variable) : Boolean = m.eAllContents(VariableReference)->exists(r | r.variable = v and isModelled(r))/]
[query public referencedVariables(a : Arrangement, m : Machine) : Sequence(Variable) =
  a.variables->select(v | isModelledVariable(v) and references(m, v))/]
[query public observedInstances(a : Arrangement, m : Machine) : Sequence(Instance) =
  a.instances->select(i | m.eAllContents(InStateExpression)->exists(e | e.instance = i and isModelled(e)))/]

[comment Transitions. /]
[query public transitionsOf(m : Machine) : Sequence(Transition) = m.eAllContents(Transition)/]
[query public earlier(s : State, t : Transition) : Sequence(Transition) =
  s.transitions->select(u | s.transitions->indexOf(u) < s.transitions->indexOf(t))/]
[query public usesInputs(s : State, t : Transition) : Boolean =
  earlier(s, t)->including(t)->exists(u | isHavocked(u.label) or u.label.eAllContents(Expression)->exists(e | isHavocked(e)))/]

[template public generate(a : Arrangement)]
[comment @main /]
[let problems = parameterProblems()->addAll(verificationProblems(a))]
[if (problems->notEmpty())]
[for (p : String | problems)]
error [p/]
[/for]
[else]
[file (a.name + '.smv', false)]
-- Generated by the smv templates from the arrangement [a.name/].
[if (havoc())]
-- WARNING: generated with opaque=havoc: opaque values and calls that cannot be represented are unconstrained, and opaque statements do nothing.
[/if]
[roundRobinModule(a)/]
[if (externals(a)->notEmpty())]
[environmentModule(a)/]
[/if]
[if (sharedVariables(a)->notEmpty())]
[sharedModule(a)/]
[/if]
[if (tables(a)->notEmpty())]
[functionsModule(a)/]
[/if]
[for (m : Machine | a.machines)]
[machineModule(a, m)/]
[/for]
[mainModule(a)/]
[/file]
[/if]
[/let]
[/template]

[template public keep(v : Variable)][if (v.type.oclIsKindOf(ArrayType))][keepCell(v, 0)/][else]next([id(v.name)/]) = [id(v.name)/][/if][/template]
[template public keepCell(v : Variable, k : Integer)]next([id(v.name)/]['['/][k/][']'/]) = [id(v.name)/]['['/][k/][']'/][if (k + 1 < v.type.oclAsType(ArrayType).size)] & [keepCell(v, k + 1)/][/if][/template]

[template public update(v : Variable, s : State)][if (v.type.oclIsKindOf(ArrayType))][updateCell(v, s, 0)/][elseif (assignments(s, v)->isEmpty())][keep(v)/][else]next([id(v.name)/]) = [ex(assignments(s, v)->first().value)/][/if][/template]
[template public updateCell(v : Variable, s : State, k : Integer)]next([id(v.name)/]['['/][k/][']'/]) = [if (assignments(s, v)->isEmpty())][id(v.name)/]['['/][k/][']'/][else](case [for (x : Assignment | assignments(s, v))][ex(x.target.index)/] = [k/] : [ex(x.value)/]; [/for]TRUE : [id(v.name)/]['['/][k/][']'/]; esac)[/if][if (k + 1 < v.type.oclAsType(ArrayType).size)] & [updateCell(v, s, k + 1)/][/if][/template]

[template public frame(a : Arrangement, m : Machine)][for (v : Variable | writtenShared(a, m))] & [keep(v)/][/for][for (v : Variable | locals(m))] & [keep(v)/][/for][/template]
[template public effects(a : Arrangement, m : Machine, s : State)][for (v : Variable | writtenShared(a, m))] & [update(v, s)/][/for][for (v : Variable | locals(m))] & [update(v, s)/][/for][/template]

[template public acceptingCondition(m : Machine)][let accepting = m.states->select(s | isAccepting(s))][if (accepting->isEmpty())]FALSE[else][for (s : State | accepting) separator(' | ')]pc = [id(s.name)/][/for][/if][/let][/template]

[template public tName(m : Machine, s : State, t : Transition)]t[transitionsOf(m)->indexOf(t)/]_[id(s.name)/]_[id(t.target.name)/][/template]

[template public tDefine(m : Machine, s : State, t : Transition)][tName(m, s, t)/] := executing & !entered & pc = [id(s.name)/][for (u : Transition | earlier(s, t))] & !([tName(m, s, u)/])[/for] & [ex(t.label)/];[/template]

[template public allTransitions(m : Machine)][for (t : Transition | transitionsOf(m)) separator(' | ')][tName(m, t.eContainer(State), t)/][/for][/template]

[template public advanceDefine(m : Machine)]advance := (executing & entered & accepting) | none[for (s : State | m.states)][for (t : Transition | s.transitions->reject(x | x.target.passThrough))] | [tName(m, s, t)/][/for][/for];[/template]

[template public machineModule(a : Arrangement, m : Machine)]

MODULE [id(m.name)/](executing[for (v : Variable | referencedVariables(a, m))], [id(v.name)/][/for][for (inst : Instance | observedInstances(a, m))], [id(inst.name)/][/for][if (callsTables(m))], fn[/if])
VAR
pc : {[for (s : State | m.states) separator(', ')][id(s.name)/][/for]};
entered : boolean;
[for (v : Variable | locals(m))]
[id(v.name)/] : [ty(v.type)/];
[/for]
[if (havocked(m)->notEmpty())]
IVAR
[for (e : Expression | havocked(m))]
[havocName(e)/] : [if (isUntypedLabel(e))]boolean[else][ty(havocType(e))/][/if];
[/for]
[/if]
INIT
pc = [id(m.initial.name)/] & entered
DEFINE
accepting := [acceptingCondition(m)/];
[for (s : State | m.states)]
[for (t : Transition | s.transitions)]
[tDefine(m, s, t)/]
[/for]
[/for]
none := executing & !entered[if (transitionsOf(m)->notEmpty())] & !([allTransitions(m)/])[/if];
[advanceDefine(m)/]
TRANS
case
!executing : next(pc) = pc & next(entered) = entered[for (v : Variable | locals(m))] & [keep(v)/][/for];
[if (fused())]
entered & pc = [id(m.initial.name)/] : next(pc) = pc & next(entered) = FALSE[effects(a, m, m.initial)/];
[for (s : State | m.states)]
[for (t : Transition | s.transitions)]
[tName(m, s, t)/] : next(pc) = [id(t.target.name)/] & next(entered) = FALSE[effects(a, m, t.target)/];
[/for]
[/for]
[else]
[for (s : State | m.states)]
entered & pc = [id(s.name)/] : next(pc) = pc & next(entered) = FALSE[effects(a, m, s)/];
[/for]
[for (s : State | m.states)]
[for (t : Transition | s.transitions)]
[tName(m, s, t)/] : next(pc) = [id(t.target.name)/] & next(entered) = TRUE[frame(a, m)/];
[/for]
[/for]
[/if]
TRUE : next(pc) = pc & next(entered) = entered[frame(a, m)/];
esac
[/template]

[template public initialValue(v : Variable, inst : Instance)][let value = initialExpression(inst, v)][if (not value.oclIsUndefined())][ex(value)/][elseif (v.type.oclIsKindOf(ArrayType))][defaultValue(v.type.oclAsType(ArrayType).element)/][else][defaultValue(v.type)/][/if][/let][/template]
[template public initialiseCell(v : Variable, path : String, inst : Instance, k : Integer)][path/]['['/][k/][']'/] = [initialValue(v, inst)/][if (k + 1 < v.type.oclAsType(ArrayType).size)] & [initialiseCell(v, path, inst, k + 1)/][/if][/template]
[template public initialise(v : Variable, path : String, inst : Instance)][if (v.type.oclIsKindOf(ArrayType))][initialiseCell(v, path, inst, 0)/][else][path/] = [initialValue(v, inst)/][/if][/template]

[comment Whether a variable starts at a value that the model fixes: its initial value is not havocked. /]
[query public hasFixedStart(v : Variable, inst : Instance) : Boolean =
  initialExpression(inst, v).oclIsUndefined() or not (isHavocked(initialExpression(inst, v)) or initialExpression(inst, v).eAllContents(Expression)->exists(e | isHavocked(e)))/]

[template public rangeCell(path : String, t : ArrayType, k : Integer)][path/]['['/][k/][']'/] >= [t.element.oclAsType(IntegerType).lower/] & [path/]['['/][k/][']'/] <= [t.element.oclAsType(IntegerType).upper/][if (k + 1 < t.size)] & [rangeCell(path, t, k + 1)/][/if][/template]
[template public range(path : String, t : IntegerType)][path/] >= [t.lower/] & [path/] <= [t.upper/][/template]
[template public range(path : String, t : ArrayType)][rangeCell(path, t, 0)/][/template]

[template public roundRobinModule(a : Arrangement)]
[let n = a.instances->size()]

MODULE RoundRobin(advance)
VAR
turn : 0..[n - 1/];
[if (hasRound())]
round : 0..[roundLimit()/];
[/if]
INIT
turn = 0
[if (hasRound())]
INIT
round = 0
[/if]
DEFINE
[for (inst : Instance | a.instances)]
executing_[turnOf(a, inst)/] := turn = [turnOf(a, inst)/];
[/for]
[for (inst : Instance | a.instances)]
executing_[id(inst.name)/] := executing_[turnOf(a, inst)/];
[/for]
TRANS
next(turn) = case
advance : (turn + 1) mod [n/];
TRUE : turn;
esac
[if (hasRound())]
TRANS
next(round) = case
advance & turn = [n - 1/] & round < [roundLimit()/] : round + 1;
TRUE : round;
esac
[/if]
[/let]
[/template]

[template public environmentModule(a : Arrangement)]

MODULE Environment(advance)
VAR
[for (v : Variable | externals(a))]
[id(v.name)/] : [ty(v.type)/];
[/for]
[for (v : Variable | externals(a))]
TRANS
advance | ([keep(v)/])
[/for]
[/template]

[template public sharedModule(a : Arrangement)]

MODULE Shared(turn)
VAR
[for (v : Variable | sharedVariables(a))]
[id(v.name)/] : [ty(v.type)/];
[/for]
[for (v : Variable | sharedVariables(a))]
TRANS
[if (writers(a, v)->isEmpty())]
[keep(v)/]
[else]
!(turn in {[for (inst : Instance | writers(a, v)) separator(', ')][turnOf(a, inst)/][/for]}) -> ([keep(v)/])
[/if]
[/for]
[/template]

[template public functionsModule(a : Arrangement)]

MODULE Functions
FROZENVAR
[for (f : FunctionDeclaration | tables(a))]
[tableName(f)/] : [for (t : Type | domain(f))]array [tableRange(t)/] of [/for][ty(f.result)/];
[/for]
[/template]

[template public actual(v : Variable)][if (v.external)]env.[id(v.name)/][else]shared.[id(v.name)/][/if][/template]

[template public mainModule(a : Arrangement)]

MODULE main
VAR
sch : RoundRobin(advance);
[if (externals(a)->notEmpty())]
env : Environment(advance);
[/if]
[if (sharedVariables(a)->notEmpty())]
shared : Shared(sch.turn);
[/if]
[if (tables(a)->notEmpty())]
fn : Functions;
[/if]
[for (inst : Instance | a.instances)]
[id(inst.name)/] : [id(inst.machine.name)/](sch.executing_[turnOf(a, inst)/][for (v : Variable | referencedVariables(a, inst.machine))], [actual(v)/][/for][for (other : Instance | observedInstances(a, inst.machine))], [id(other.name)/][/for][if (callsTables(inst.machine))], fn[/if]);
[/for]
[for (v : Variable | sharedVariables(a)->select(x | hasFixedStart(x, a.instances->first())))]
INIT
[initialise(v, 'shared.' + id(v.name), a.instances->first())/]
[/for]
[for (inst : Instance | a.instances)]
[for (v : Variable | locals(inst.machine)->select(x | hasFixedStart(x, inst)))]
INIT
[initialise(v, id(inst.name) + '.' + id(v.name), inst)/]
[/for]
[/for]
DEFINE
advance := [for (inst : Instance | a.instances) separator(' | ')][id(inst.name)/].advance[/for];
halted := [for (inst : Instance | a.instances) separator(' & ')][id(inst.name)/].accepting & !([id(inst.name)/].entered)[/for];
[for (v : Variable | sharedVariables(a)->select(x | isIntegerTyped(x.type)))]
INVARSPEC
[range('shared.' + id(v.name), v.type)/]
[/for]
[for (inst : Instance | a.instances)]
[for (v : Variable | locals(inst.machine)->select(x | isIntegerTyped(x.type)))]
INVARSPEC
[range(id(inst.name) + '.' + id(v.name), v.type)/]
[/for]
[/for]
[if (sanity())]
[sanityProperties(a)/]
[/if]
[/template]

[template public sanityProperties(a : Arrangement)]
[for (inst : Instance | a.instances)]
[for (s : State | inst.machine.states)]
CTLSPEC
EF ([id(inst.name)/].pc = [id(s.name)/])
[if (not isAccepting(s))]
CTLSPEC
AG ([id(inst.name)/].pc = [id(s.name)/] -> EF [id(inst.name)/].pc != [id(s.name)/])
[/if]
[/for]
[for (s : State | inst.machine.states)]
[for (t : Transition | s.transitions->reject(x | usesInputs(s, x)))]
CTLSPEC
EF [id(inst.name)/].[tName(inst.machine, s, t)/]
[/for]
[/for]
[/for]
[/template]
