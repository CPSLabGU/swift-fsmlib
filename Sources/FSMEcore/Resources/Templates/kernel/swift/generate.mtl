[comment]
Swift 6 execution target for kernel arrangements.

Generates <Arrangement>.swift, a program that runs the arrangement round
by round and prints its canonical trace (see the C target for the trace
and the inputs format; the program takes the same arguments). The entry
point is an @main type, so the file is compiled with -parse-as-library.

All state lives in an instance of the arrangement class that the entry
point creates, so the program has no global mutable state. Host
declarations for the language swift come after the typed kernel types;
opaque types are type aliases of their text. Declared functions are
called with unlabelled arguments, so their implementations, in the host
declarations or another source file, declare their parameters with _.
[/comment]
[module generate('http://cpslabgu.github.io/llfsm/kernel')/]
[import expressions::kernel/]
[import expressions::swift/]

[comment The external and the other shared variables. /]
[query public externals(a : Arrangement) : Sequence(Variable) = a.variables->select(v | v.external)/]
[query public sharedVariables(a : Arrangement) : Sequence(Variable) = a.variables->reject(v | v.external)/]

[comment The typed scalar types, declared before the host declarations. /]
[query public scalarTypes(a : Arrangement) : Sequence(Type) =
  a.types->select(t | t.oclIsKindOf(BooleanType) or t.oclIsKindOf(IntegerType) or t.oclIsKindOf(EnumerationType))/]

[template public generate(a : Arrangement)]
[comment @main /]
[let problems = codeProblems(a, targetLanguage())]
[if (problems->notEmpty())]
[for (p : String | problems)]
error [p/]
[/for]
[else]
[program(a)/]
[/if]
[/let]
[/template]

[comment The value with which a variable is declared: an opaque initial value, else the default of its type. /]
[template public declaredValue(v : Variable)][if (v.type.oclIsKindOf(OpaqueType) and not v.initialValue.oclIsUndefined())][expr(v.initialValue)/][else][defaultOfType(v.type)/][/if][/template]

[comment A statement that sets a typed variable, given as an lvalue, to its initial value, if it has one. /]
[template public initialise(lvalue : String, v : Variable, value : Expression)]
[if (not value.oclIsUndefined() and not v.type.oclIsKindOf(ArrayType) and not v.type.oclIsKindOf(OpaqueType))]
        [lvalue/] = [expr(value)/]
[/if]
[/template]

[template public program(a : Arrangement)]
[file (a.name + '.swift', false)]
// Generated by the kernel-swift templates from the arrangement [a.name/].
import Foundation
[for (h : HostDeclarations | hostDeclarationsFor(a, targetLanguage()))]
[if (not h.includes.oclIsUndefined() and h.includes <> '')]
[h.includes/]
[/if]
[/for]

func llfsmFail(_ message: String, code: Int32) -> Never {
    FileHandle.standardError.write(Data((message + "\n").utf8))
    exit(code)
}

func llfsmCheck(_ value: Swift.Int, _ lower: Swift.Int, _ upper: Swift.Int, _ name: String) -> Swift.Int {
    if value < lower || value > upper {
        llfsmFail("range violation \(name)", code: 2)
    }
    return value
}

func llfsmIndex(_ index: Swift.Int, _ size: Swift.Int, _ name: String) -> Swift.Int {
    llfsmCheck(index, 0, size - 1, name)
}
[for (t : Type | scalarTypes(a))]

[if (t.oclIsKindOf(BooleanType))]
typealias [t.name/] = Swift.Bool

func llfsmParse_[t.name/](_ text: String) -> [t.name/]? {
    text == "true" ? true : (text == "false" ? false : nil)
}
[elseif (t.oclIsKindOf(IntegerType))]
typealias [t.name/] = Swift.Int

func llfsmParse_[t.name/](_ text: String) -> [t.name/]? {
    guard let value = Swift.Int(text), value >= [t.oclAsType(IntegerType).lower/], value <= [t.oclAsType(IntegerType).upper/] else {
        return nil
    }
    return value
}
[else]
enum [t.name/]: Swift.Int, CaseIterable {
    case [for (l : String | t.oclAsType(EnumerationType).literals) separator(', ')]`[l/]`[/for]
}

func llfsmParse_[t.name/](_ text: String) -> [t.name/]? {
    [t.name/].allCases.first { "\($0)" == text }
}
[/if]
[/for]
[for (h : HostDeclarations | hostDeclarationsFor(a, targetLanguage()))]
[if (not h.declarations.oclIsUndefined() and h.declarations <> '')]

[h.declarations/]
[/if]
[if (not h.functions.oclIsUndefined() and h.functions <> '')]

[h.functions/]
[/if]
[/for]
[for (t : Type | a.types->select(x | x.oclIsKindOf(OpaqueType)))]

typealias [t.name/] = [t.oclAsType(OpaqueType).text/]
[/for]
[for (t : Type | a.types->select(x | x.oclIsKindOf(ArrayType)))]

typealias [t.name/] = ['['/][t.oclAsType(ArrayType).element.name/][']'/]
[/for]
[if (externals(a)->notEmpty())]

struct LLFSMEnvironment {
[for (v : Variable | externals(a))]
    var [v.name/]: [v.type.name/] = [declaredValue(v)/]
[/for]
}
[/if]
[for (m : Machine | a.machines)]

enum [m.name/]_State: Swift.Int, CaseIterable {
    case [for (s : State | m.states) separator(', ')]`[s.name/]`[/for]

    static let llfsmAccepting: ['['/]Swift.Bool[']'/] = ['['/][for (s : State | m.states) separator(', ')][if (isAccepting(s))]true[else]false[/if][/for][']'/]
    static let llfsmPassThrough: ['['/]Swift.Bool[']'/] = ['['/][for (s : State | m.states) separator(', ')][if (s.passThrough)]true[else]false[/if][/for][']'/]
}

final class [m.name/]_Machine {
    var llfsmState: [m.name/]_State = .`[m.initial.name/]`
    var llfsmEntered = true
[for (v : Variable | m.variables)]
    var [v.name/]: [v.type.name/] = [declaredValue(v)/]
[/for]
}
[/for]

final class LLFSMArrangement {
[for (v : Variable | sharedVariables(a))]
    var [v.name/]: [v.type.name/] = [declaredValue(v)/]
[/for]
[if (externals(a)->notEmpty())]
    var llfsmEnvironment = LLFSMEnvironment()
[/if]
[for (inst : Instance | a.instances)]
    let llfsmInstance_[inst.name/] = [inst.machine.name/]_Machine()
[/for]

    func llfsmInitialise() {
[for (v : Variable | sharedVariables(a))]
[initialise(v.name, v, v.initialValue)/]
[/for]
[for (v : Variable | externals(a))]
[initialise('llfsmEnvironment.' + v.name, v, v.initialValue)/]
[/for]
[for (inst : Instance | a.instances)]
[for (v : Variable | inst.machine.variables)]
[initialise('llfsmInstance_' + inst.name + '.' + v.name, v, initialExpression(inst, v))/]
[/for]
[/for]
    }
[for (m : Machine | a.machines)]

    func llfsmRinglet_[m.name/](_ llfsmMachine: [m.name/]_Machine) {
[for (v : Variable | externals(a))]
        let [v.name/] = llfsmEnvironment.[v.name/]
        _ = [v.name/]
[/for]
[for (v : Variable | m.variables)]
        var [v.name/]: [v.type.name/] {
            get { llfsmMachine.[v.name/] }
            set { llfsmMachine.[v.name/] = newValue }
        }
[/for]
        while true {
            if llfsmMachine.llfsmEntered {
                llfsmMachine.llfsmEntered = false
[for (s : State | m.states->select(x | x.actions->notEmpty()))]
                if llfsmMachine.llfsmState == [m.name/]_State.`[s.name/]` {
[for (act : Statement | s.actions)]
[statement(act)/]
[/for]
                }
[/for]
            }
[if (m.states->exists(x | not isAccepting(x)))]
            var llfsmNext: [m.name/]_State?
[for (s : State | m.states->reject(x | isAccepting(x)))]
            if llfsmMachine.llfsmState == [m.name/]_State.`[s.name/]` {
[for (t : Transition | s.transitions)]
                [if (i = 1)]if[else]} else if[/if] [expr(t.label)/] {
                    llfsmNext = .`[t.target.name/]`
[/for]
                }
            }
[/for]
            guard let llfsmTarget = llfsmNext else {
                return
            }
            llfsmMachine.llfsmState = llfsmTarget
            llfsmMachine.llfsmEntered = true
            if ![m.name/]_State.llfsmPassThrough['['/]llfsmTarget.rawValue[']'/] {
                return
            }
[else]
            return
[/if]
        }
    }
[/for]

    func llfsmSetExternal(_ key: String, _ index: Swift.Int?, _ value: String) -> Swift.Bool {
        switch key {
[for (v : Variable | externals(a))]
        case "[swiftString(v.name)/]":
[if (v.type.oclIsKindOf(ArrayType))]
            guard let position = index, position >= 0, position < [v.type.oclAsType(ArrayType).size/], let parsed = llfsmParse_[v.type.oclAsType(ArrayType).element.name/](value) else {
                return false
            }
            llfsmEnvironment.[v.name/]['['/]position[']'/] = parsed
            return true
[else]
            guard index == nil, let parsed = llfsmParse_[v.type.name/](value) else {
                return false
            }
            llfsmEnvironment.[v.name/] = parsed
            return true
[/if]
[/for]
        default:
            return false
        }
    }

    func llfsmApplyAssignment(_ token: Substring) -> Swift.Bool {
        guard let equals = token.firstIndex(of: "=") else {
            return false
        }
        let key = token.prefix(upTo: equals)
        let value = String(token.suffix(from: token.index(after: equals)))
        var name = String(key)
        var index: Swift.Int?
        if let bracket = key.firstIndex(of: "\u{5B}") {
            let position = key.suffix(from: key.index(after: bracket))
            let digits = position.dropLast()
            let unsigned = digits.first == "+" || digits.first == "-" ? digits.dropFirst() : digits
            guard position.last == "\u{5D}", !unsigned.isEmpty, unsigned.allSatisfy({ $0 >= "0" && $0 <= "9" }),
                  let parsed = Swift.Int(digits) else {
                return false
            }
            name = String(key.prefix(upTo: bracket))
            index = parsed
        }
        return llfsmSetExternal(name, index, value)
    }

    func llfsmApplyInputs(_ lines: ['['/]String[']'/], round: Swift.Int) -> Swift.Bool {
        for line in lines {
            let tokens = line.split(whereSeparator: { $0 == " " || $0 == "\t" || $0 == "\r" })
            guard let first = tokens.first, Swift.Int(first) == round else {
                continue
            }
            for token in tokens.dropFirst() where !llfsmApplyAssignment(token) {
                FileHandle.standardError.write(Data("invalid input \(token)\n".utf8))
                return false
            }
        }
        return true
    }
}

@main
struct [a.name/] {
    static func main() {
        let arguments = CommandLine.arguments
        let maxRounds = arguments.count > 1 ? (Swift.Int(arguments['['/]1[']'/]) ?? 0) : 20
        var inputLines = Array<String>()
        if arguments.count > 2 {
            guard let text = try? String(contentsOfFile: arguments['['/]2[']'/], encoding: .utf8) else {
                llfsmFail("cannot open \(arguments['['/]2[']'/])", code: 1)
            }
            inputLines = text.split(separator: "\n", omittingEmptySubsequences: false).map { String($0) }
        }
        let arrangement = LLFSMArrangement()
        arrangement.llfsmInitialise()
        print("arrangement [swiftString(a.name)/]")
        var round = 1
        while true {
            if !arrangement.llfsmApplyInputs(inputLines, round: round) {
                exit(1)
            }
[for (inst : Instance | a.instances)]
            arrangement.llfsmRinglet_[inst.machine.name/](arrangement.llfsmInstance_[inst.name/])
            print("R\(round) [swiftString(inst.name)/] \(arrangement.llfsmInstance_[inst.name/].llfsmState)")
[/for]
            if [for (inst : Instance | a.instances) separator(' && ')][inst.machine.name/]_State.llfsmAccepting['['/]arrangement.llfsmInstance_[inst.name/].llfsmState.rawValue[']'/] && !arrangement.llfsmInstance_[inst.name/].llfsmEntered[/for] {
                print("halt R\(round)")
                break
            }
            if round == maxRounds {
                break
            }
            round += 1
        }
    }
}
[/file]
[/template]
