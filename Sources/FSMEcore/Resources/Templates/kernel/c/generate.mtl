[comment]
C11 execution target for kernel arrangements.

Generates <Arrangement>.c, a program that runs the arrangement round by
round and prints its canonical trace:

  arrangement <name>
  <Print text>[ <value>]*         one line per executed Print
  R<round> <instance> <state>     after every ringlet: the resting state
  halt R<round>                   when every instance accepts

Arguments: the number of rounds (default 20) and an optional inputs file
whose lines `<round> name=value name[index]=value` set external variables
at the start of a round. A value that leaves the range of its integer
variable stops the program with `range violation <variable>`.

Host declarations for the language c come first after the standard
headers and the typed kernel types; opaque types are typedefs of their
text, and declared free functions get prototypes, so their
implementations can come from the host declarations or another
translation unit. The printer of an opaque type T is print_T(value).
[/comment]
[module generate('http://cpslabgu.github.io/llfsm/kernel')/]
[import expressions::kernel/]
[import expressions::c/]

[comment The external and the other shared variables. /]
[query public externals(a : Arrangement) : Sequence(Variable) = a.variables->select(v | v.external)/]
[query public sharedVariables(a : Arrangement) : Sequence(Variable) = a.variables->reject(v | v.external)/]

[comment The typed scalar types, declared before the host declarations. /]
[query public scalarTypes(a : Arrangement) : Sequence(Type) =
  a.types->select(t | t.oclIsKindOf(BooleanType) or t.oclIsKindOf(IntegerType) or t.oclIsKindOf(EnumerationType))/]

[comment The free functions of the arrangement and its machines, which get prototypes. /]
[query public freeFunctions(a : Arrangement) : Sequence(FunctionDeclaration) =
  a.eAllContents(FunctionDeclaration)->select(f | f.receiverType.oclIsUndefined())/]

[template public generate(a : Arrangement)]
[comment @main /]
[let problems = codeProblems(a, targetLanguage())]
[if (problems->notEmpty())]
[for (p : String | problems)]
error [p/]
[/for]
[else]
[program(a)/]
[/if]
[/let]
[/template]

[comment Statements that set a variable, given as an lvalue, to a value (undefined for the default). /]
[template public initialise(lvalue : String, v : Variable, value : Expression)]
[if (v.type.oclIsKindOf(ArrayType))]
    for (int k = 0; k < [v.type.oclAsType(ArrayType).size/]; k++) {
        [lvalue/]['['/]k[']'/] = [defaultValue(v.type.oclAsType(ArrayType).element)/];
    }
[elseif (not value.oclIsUndefined())]
    [lvalue/] = [expr(value)/];
[elseif (not v.type.oclIsKindOf(OpaqueType))]
    [lvalue/] = [defaultValue(v.type)/];
[/if]
[/template]

[comment A copy of a variable into a ringlet variable of the same name. /]
[template public copyIn(v : Variable, source : String, qualifier : String)]
[if (v.type.oclIsKindOf(ArrayType))]
    [v.type.name/] [v.name/];
    memcpy([v.name/], [source/][v.name/], sizeof [v.name/]);
[else]
    [qualifier/][v.type.name/] [v.name/] = [source/][v.name/];
[/if]
[/template]

[comment A copy of a ringlet variable back into the instance. /]
[template public copyOut(v : Variable)]
[if (v.type.oclIsKindOf(ArrayType))]
    memcpy(llfsm_self->[v.name/], [v.name/], sizeof [v.name/]);
[else]
    llfsm_self->[v.name/] = [v.name/];
[/if]
[/template]

[template public program(a : Arrangement)]
[file (a.name + '.c', false)]
/* Generated by the kernel-c templates from the arrangement [a.name/]. */
#include <errno.h>
#include <limits.h>
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
[for (h : HostDeclarations | hostDeclarationsFor(a, targetLanguage()))]
[if (not h.includes.oclIsUndefined() and h.includes <> '')]
[h.includes/]
[/if]
[/for]

int llfsm_check(int value, int lower, int upper, const char *name)
{
    if (value < lower || value > upper) {
        fflush(stdout);
        fprintf(stderr, "range violation %s\n", name);
        exit(2);
    }
    return value;
}

int llfsm_index(int index, int size, const char *name)
{
    return llfsm_check(index, 0, size - 1, name);
}

void llfsm_print_bool(bool value)
{
    fputs(value ? "true" : "false", stdout);
}

void llfsm_print_int(int value)
{
    printf("%d", value);
}
[for (t : Type | scalarTypes(a))]

[if (t.oclIsKindOf(BooleanType))]
typedef bool [t.name/];

bool llfsm_parse_[t.name/](const char *text, [t.name/] *out)
{
    if (strcmp(text, "true") == 0 || strcmp(text, "false") == 0) {
        *out = strcmp(text, "true") == 0;
        return true;
    }
    return false;
}
[elseif (t.oclIsKindOf(IntegerType))]
typedef int [t.name/];

bool llfsm_parse_[t.name/](const char *text, [t.name/] *out)
{
    char *end;
    errno = 0;
    long value = strtol(text, &end, 10);
    if (end == text || *end != '\0' || errno != 0 || value < [t.oclAsType(IntegerType).lower/] || value > [t.oclAsType(IntegerType).upper/]) {
        return false;
    }
    *out = (int)value;
    return true;
}
[else]
typedef enum { [for (l : String | t.oclAsType(EnumerationType).literals) separator(', ')][t.name/]_[l/][/for] } [t.name/];

const char *const llfsm_[t.name/]_names['['/][']'/] = { [for (l : String | t.oclAsType(EnumerationType).literals) separator(', ')]"[cString(l)/]"[/for] };

void llfsm_print_[t.name/]([t.name/] value)
{
    fputs(llfsm_[t.name/]_names['['/]value[']'/], stdout);
}

bool llfsm_parse_[t.name/](const char *text, [t.name/] *out)
{
    for (int k = 0; k < [t.oclAsType(EnumerationType).literals->size()/]; k++) {
        if (strcmp(text, llfsm_[t.name/]_names['['/]k[']'/]) == 0) {
            *out = ([t.name/])k;
            return true;
        }
    }
    return false;
}
[/if]
[/for]
[for (h : HostDeclarations | hostDeclarationsFor(a, targetLanguage()))]
[if (not h.declarations.oclIsUndefined() and h.declarations <> '')]

[h.declarations/]
[/if]
[/for]
[for (t : Type | a.types->select(x | x.oclIsKindOf(OpaqueType)))]

typedef [t.oclAsType(OpaqueType).text/] [t.name/];
[/for]
[for (t : Type | a.types->select(x | x.oclIsKindOf(ArrayType)))]

typedef [t.oclAsType(ArrayType).element.name/] [t.name/]['['/][t.oclAsType(ArrayType).size/][']'/];
[/for]
[if (freeFunctions(a)->notEmpty())]

[for (f : FunctionDeclaration | freeFunctions(a))]
[if (f.result.oclIsUndefined())]void[else][f.result.name/][/if] [f.name/]([if (f.parameters->isEmpty())]void[else][for (p : Parameter | f.parameters) separator(', ')][p.type.name/] [p.name/][/for][/if]);
[/for]
[/if]
[if (sharedVariables(a)->notEmpty())]

[for (v : Variable | sharedVariables(a))]
[v.type.name/] [v.name/];
[/for]
[/if]
[if (externals(a)->notEmpty())]

typedef struct {
[for (v : Variable | externals(a))]
    [v.type.name/] [v.name/];
[/for]
} llfsm_Environment;

llfsm_Environment llfsm_environment;
[/if]
[for (m : Machine | a.machines)]

typedef enum { [for (s : State | m.states) separator(', ')][m.name/]_[s.name/][/for] } [m.name/]_State;

const char *const llfsm_[m.name/]_State_names['['/][']'/] = { [for (s : State | m.states) separator(', ')]"[cString(s.name)/]"[/for] };
const bool llfsm_[m.name/]_State_accepting['['/][']'/] = { [for (s : State | m.states) separator(', ')][if (isAccepting(s))]true[else]false[/if][/for] };
const bool llfsm_[m.name/]_State_pass_through['['/][']'/] = { [for (s : State | m.states) separator(', ')][if (s.passThrough)]true[else]false[/if][/for] };

typedef struct {
    [m.name/]_State llfsm_pc;
    bool llfsm_entered;
[for (v : Variable | m.variables)]
    [v.type.name/] [v.name/];
[/for]
} [m.name/]_Machine;
[/for]

[for (inst : Instance | a.instances)]
[inst.machine.name/]_Machine llfsm_instance_[inst.name/];
[/for]
[for (m : Machine | a.machines)]

void llfsm_ringlet_[m.name/]([m.name/]_Machine *llfsm_self)
{
[for (v : Variable | externals(a))]
[copyIn(v, 'llfsm_environment.', 'const ')/]
[/for]
[for (v : Variable | m.variables)]
[copyIn(v, 'llfsm_self->', '')/]
[/for]
[for (v : Variable | externals(a)->addAll(m.variables))]
    (void)[v.name/];
[/for]
    for (;;) {
        if (llfsm_self->llfsm_entered) {
            llfsm_self->llfsm_entered = false;
            switch (llfsm_self->llfsm_pc) {
[for (s : State | m.states->select(x | x.actions->notEmpty()))]
            case [m.name/]_[s.name/]:
[for (act : Statement | s.actions)]
[statement(act)/]
[/for]
                break;
[/for]
            default:
                break;
            }
        }
        bool llfsm_fired = true;
        switch (llfsm_self->llfsm_pc) {
[for (s : State | m.states->reject(x | isAccepting(x)))]
        case [m.name/]_[s.name/]:
[for (t : Transition | s.transitions)]
            [if (i = 1)]if[else]} else if[/if] [condition(t.label)/] {
                llfsm_self->llfsm_pc = [m.name/]_[t.target.name/];
[/for]
            } else {
                llfsm_fired = false;
            }
            break;
[/for]
        default:
            llfsm_fired = false;
            break;
        }
        if (!llfsm_fired) {
            break;
        }
        llfsm_self->llfsm_entered = true;
        if (!llfsm_[m.name/]_State_pass_through['['/]llfsm_self->llfsm_pc[']'/]) {
            break;
        }
    }
[for (v : Variable | m.variables)]
[copyOut(v)/]
[/for]
}
[/for]

void llfsm_initialise(void)
{
[for (v : Variable | sharedVariables(a))]
[initialise(v.name, v, v.initialValue)/]
[/for]
[for (v : Variable | externals(a))]
[initialise('llfsm_environment.' + v.name, v, v.initialValue)/]
[/for]
[for (inst : Instance | a.instances)]
    llfsm_instance_[inst.name/].llfsm_pc = [inst.machine.name/]_[inst.machine.initial.name/];
    llfsm_instance_[inst.name/].llfsm_entered = true;
[for (v : Variable | inst.machine.variables)]
[initialise('llfsm_instance_' + inst.name + '.' + v.name, v, initialExpression(inst, v))/]
[/for]
[/for]
}

bool llfsm_set_external(const char *key, bool indexed, int index, const char *value)
{
    (void)key;
    (void)indexed;
    (void)index;
    (void)value;
[for (v : Variable | externals(a))]
    if (strcmp(key, "[cString(v.name)/]") == 0) {
[if (v.type.oclIsKindOf(ArrayType))]
        return indexed && index >= 0 && index < [v.type.oclAsType(ArrayType).size/] && llfsm_parse_[v.type.oclAsType(ArrayType).element.name/](value, &llfsm_environment.[v.name/]['['/]index[']'/]);
[else]
        return !indexed && llfsm_parse_[v.type.name/](value, &llfsm_environment.[v.name/]);
[/if]
    }
[/for]
    return false;
}

bool llfsm_apply_assignment(const char *token)
{
    char parts['['/]1024[']'/];
    if (strlen(token) >= sizeof parts) {
        return false;
    }
    strcpy(parts, token);
    char *equals = strchr(parts, '=');
    if (equals == NULL) {
        return false;
    }
    *equals = '\0';
    bool indexed = false;
    int index = 0;
    char *bracket = strchr(parts, '\x5b');
    if (bracket != NULL) {
        char *digits = bracket + 1;
        if (*digits != '+' && *digits != '-' && (*digits < '0' || *digits > '9')) {
            return false;
        }
        char *close;
        errno = 0;
        long position = strtol(digits, &close, 10);
        if (errno != 0 || position < INT_MIN || position > INT_MAX || *close != '\x5d' || close['['/]1[']'/] != '\0') {
            return false;
        }
        *bracket = '\0';
        indexed = true;
        index = (int)position;
    }
    return llfsm_set_external(parts, indexed, index, equals + 1);
}

bool llfsm_apply_inputs(FILE *inputs, int round)
{
    if (inputs == NULL) {
        return true;
    }
    char line['['/]1024[']'/];
    rewind(inputs);
    while (fgets(line, sizeof line, inputs) != NULL) {
        char *end;
        long when = strtol(line, &end, 10);
        if (end == line || when != round) {
            continue;
        }
        for (char *token = strtok(end, " \t\r\n"); token != NULL; token = strtok(NULL, " \t\r\n")) {
            if (!llfsm_apply_assignment(token)) {
                fprintf(stderr, "invalid input %s\n", token);
                return false;
            }
        }
    }
    return true;
}

int main(int argc, char **argv)
{
    int max_rounds = argc > 1 ? atoi(argv['['/]1[']'/]) : 20;
    FILE *inputs = NULL;
    if (argc > 2) {
        inputs = fopen(argv['['/]2[']'/], "r");
        if (inputs == NULL) {
            fprintf(stderr, "cannot open %s\n", argv['['/]2[']'/]);
            return 1;
        }
    }
    llfsm_initialise();
    printf("arrangement [cString(a.name)/]\n");
    for (int round = 1; ; round++) {
        if (!llfsm_apply_inputs(inputs, round)) {
            return 1;
        }
[for (inst : Instance | a.instances)]
        llfsm_ringlet_[inst.machine.name/](&llfsm_instance_[inst.name/]);
        printf("R%d [cString(inst.name)/] %s\n", round, llfsm_[inst.machine.name/]_State_names['['/]llfsm_instance_[inst.name/].llfsm_pc[']'/]);
[/for]
        if ([for (inst : Instance | a.instances) separator(' && ')]llfsm_[inst.machine.name/]_State_accepting['['/]llfsm_instance_[inst.name/].llfsm_pc[']'/] && !llfsm_instance_[inst.name/].llfsm_entered[/for]) {
            printf("halt R%d\n", round);
            break;
        }
        if (round == max_rounds) {
            break;
        }
    }
    if (inputs != NULL) {
        fclose(inputs);
    }
    return 0;
}
[/file]
[/template]
