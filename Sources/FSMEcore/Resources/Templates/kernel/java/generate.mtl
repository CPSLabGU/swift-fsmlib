[comment]
Java 17 execution target for kernel arrangements.

Generates <Arrangement>.java, a program that runs the arrangement round by
round and prints its canonical trace (see the C target for the trace and
the inputs format; the program takes the same arguments).

Boolean and integer types map to boolean and int, enumeration types to
nested enums, array types to Java arrays and opaque types to their text.
Host declarations for the language java follow the imports, at the top
level of the file, so they can declare helper classes such as the class
<Arrangement>Host whose static methods implement the free functions; the
class can also come from another source file.
[/comment]
[module generate('http://cpslabgu.github.io/llfsm/kernel')/]
[import expressions::kernel/]
[import expressions::java/]

[comment The external and the other shared variables. /]
[query public externals(a : Arrangement) : Sequence(Variable) = a.variables->select(v | v.external)/]
[query public sharedVariables(a : Arrangement) : Sequence(Variable) = a.variables->reject(v | v.external)/]

[template public generate(a : Arrangement)]
[comment @main /]
[let problems = codeProblems(a, targetLanguage())]
[if (problems->notEmpty())]
[for (p : String | problems)]
error [p/]
[/for]
[else]
[program(a)/]
[/if]
[/let]
[/template]

[comment Statements that set a variable, given as an lvalue, to a value (undefined for the default). /]
[template public initialise(lvalue : String, v : Variable, value : Expression)]
[if (v.type.oclIsKindOf(ArrayType))]
        [lvalue/] = new [javaType(v.type.oclAsType(ArrayType).element)/]['['/][v.type.oclAsType(ArrayType).size/][']'/];
        for (int k = 0; k < [v.type.oclAsType(ArrayType).size/]; k++) {
            [lvalue/]['['/]k[']'/] = [defaultValue(v.type.oclAsType(ArrayType).element)/];
        }
[elseif (not value.oclIsUndefined())]
        [lvalue/] = [expr(value)/];
[elseif (not v.type.oclIsKindOf(OpaqueType))]
        [lvalue/] = [defaultValue(v.type)/];
[/if]
[/template]

[template public program(a : Arrangement)]
[file (a.name + '.java', false)]
// Generated by the kernel-java templates from the arrangement [a.name/].
import java.io.FileDescriptor;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.PrintStream;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.List;
[for (h : HostDeclarations | hostDeclarationsFor(a, targetLanguage()))]
[if (not h.includes.oclIsUndefined() and h.includes <> '')]
[h.includes/]
[/if]
[/for]
[for (h : HostDeclarations | hostDeclarationsFor(a, targetLanguage()))]
[if (not h.declarations.oclIsUndefined() and h.declarations <> '')]

[h.declarations/]
[/if]
[/for]

public final class [a.name/] {
    private [a.name/]() {
    }

    static int llfsmCheck(int value, int lower, int upper, String name) {
        if (value < lower || value > upper) {
            System.out.flush();
            System.err.println("range violation " + name);
            System.exit(2);
        }
        return value;
    }

    static int llfsmIndex(int index, int size, String name) {
        return llfsmCheck(index, 0, size - 1, name);
    }
[for (t : Type | a.types->select(x | x.oclIsKindOf(EnumerationType)))]

    enum [t.name/] {
        [for (l : String | t.oclAsType(EnumerationType).literals) separator(', ')][l/][/for]
    }
[/for]
[for (t : Type | a.types->select(x | x.oclIsKindOf(BooleanType) or x.oclIsKindOf(IntegerType) or x.oclIsKindOf(EnumerationType)))]

    static [javaBoxed(t)/] llfsmParse_[t.name/](String text) {
[if (t.oclIsKindOf(BooleanType))]
        if (text.equals("true") || text.equals("false")) {
            return text.equals("true");
        }
        return null;
[elseif (t.oclIsKindOf(IntegerType))]
        try {
            long value = Long.parseLong(text);
            if (value < [t.oclAsType(IntegerType).lower/] || value > [t.oclAsType(IntegerType).upper/]) {
                return null;
            }
            return (int) value;
        } catch (NumberFormatException e) {
            return null;
        }
[else]
        for ([t.name/] candidate : [t.name/].values()) {
            if (candidate.toString().equals(text)) {
                return candidate;
            }
        }
        return null;
[/if]
    }
[/for]
[if (sharedVariables(a)->notEmpty())]

[for (v : Variable | sharedVariables(a))]
    static [javaType(v.type)/] [v.name/];
[/for]
[/if]
[if (externals(a)->notEmpty())]

    static final class LLFSMEnvironment {
[for (v : Variable | externals(a))]
        [javaType(v.type)/] [v.name/];
[/for]

        LLFSMEnvironment llfsmCopy() {
            LLFSMEnvironment copy = new LLFSMEnvironment();
[for (v : Variable | externals(a))]
            copy.[v.name/] = [v.name/][if (v.type.oclIsKindOf(ArrayType))].clone()[/if];
[/for]
            return copy;
        }
    }

    static LLFSMEnvironment llfsmEnvironment = new LLFSMEnvironment();
[/if]
[for (m : Machine | a.machines)]

    enum [m.name/]_State {
        [for (s : State | m.states) separator(', ')]S_[s.name/]("[javaString(s.name)/]", [if (isAccepting(s))]true[else]false[/if], [if (s.passThrough)]true[else]false[/if])[/for];

        final String llfsmLabel;
        final boolean llfsmAccepting;
        final boolean llfsmPassThrough;

        [m.name/]_State(String llfsmLabel, boolean llfsmAccepting, boolean llfsmPassThrough) {
            this.llfsmLabel = llfsmLabel;
            this.llfsmAccepting = llfsmAccepting;
            this.llfsmPassThrough = llfsmPassThrough;
        }
    }

    static final class [m.name/]_Machine {
        [m.name/]_State llfsmState;
        boolean llfsmEntered;
[for (v : Variable | m.variables)]
        [javaType(v.type)/] [v.name/];
[/for]

        void llfsmRinglet() {
[if (externals(a)->notEmpty())]
            final LLFSMEnvironment llfsmSnapshot = llfsmEnvironment.llfsmCopy();
[for (v : Variable | externals(a))]
            final [javaType(v.type)/] [v.name/] = llfsmSnapshot.[v.name/];
[/for]
[/if]
            for (;;) {
                if (llfsmEntered) {
                    llfsmEntered = false;
[for (s : State | m.states->select(x | x.actions->notEmpty()))]
                    if (llfsmState == [m.name/]_State.S_[s.name/]) {
[for (act : Statement | s.actions)]
[statement(act)/]
[/for]
                    }
[/for]
                }
[if (m.states->exists(x | not isAccepting(x)))]
                [m.name/]_State llfsmNext = null;
[for (s : State | m.states->reject(x | isAccepting(x)))]
                if (llfsmState == [m.name/]_State.S_[s.name/]) {
[for (t : Transition | s.transitions)]
                    [if (i = 1)]if[else]} else if[/if] [condition(t.label)/] {
                        llfsmNext = [m.name/]_State.S_[t.target.name/];
[/for]
                    }
                }
[/for]
                if (llfsmNext == null) {
                    return;
                }
                llfsmState = llfsmNext;
                llfsmEntered = true;
                if (!llfsmState.llfsmPassThrough) {
                    return;
                }
[else]
                return;
[/if]
            }
        }
    }
[/for]

[for (inst : Instance | a.instances)]
    static final [inst.machine.name/]_Machine llfsmInstance_[inst.name/] = new [inst.machine.name/]_Machine();
[/for]

    static void llfsmInitialise() {
[for (v : Variable | sharedVariables(a))]
[initialise(v.name, v, v.initialValue)/]
[/for]
[for (v : Variable | externals(a))]
[initialise('llfsmEnvironment.' + v.name, v, v.initialValue)/]
[/for]
[for (inst : Instance | a.instances)]
        llfsmInstance_[inst.name/].llfsmState = [inst.machine.name/]_State.S_[inst.machine.initial.name/];
        llfsmInstance_[inst.name/].llfsmEntered = true;
[for (v : Variable | inst.machine.variables)]
[initialise('llfsmInstance_' + inst.name + '.' + v.name, v, initialExpression(inst, v))/]
[/for]
[/for]
    }

    static boolean llfsmSetExternal(String key, int index, String value) {
        if (key.isEmpty() || value.isEmpty() || index < -1) {
            return false;
        }
[for (v : Variable | externals(a))]
        if (key.equals("[javaString(v.name)/]")) {
[if (v.type.oclIsKindOf(ArrayType))]
            if (index < 0 || index >= [v.type.oclAsType(ArrayType).size/]) {
                return false;
            }
            [javaBoxed(v.type.oclAsType(ArrayType).element)/] parsed = llfsmParse_[v.type.oclAsType(ArrayType).element.name/](value);
            if (parsed == null) {
                return false;
            }
            llfsmEnvironment.[v.name/]['['/]index[']'/] = parsed;
            return true;
[else]
            if (index >= 0) {
                return false;
            }
            [javaBoxed(v.type)/] parsed = llfsmParse_[v.type.name/](value);
            if (parsed == null) {
                return false;
            }
            llfsmEnvironment.[v.name/] = parsed;
            return true;
[/if]
        }
[/for]
        return false;
    }

    static boolean llfsmApplyAssignment(String token) {
        int equals = token.indexOf('=');
        if (equals < 0) {
            return false;
        }
        String key = token.substring(0, equals);
        String value = token.substring(equals + 1);
        int index = -1;
        int bracket = key.indexOf(91);
        if (bracket >= 0) {
            if (key.charAt(key.length() - 1) != 93) {
                return false;
            }
            try {
                index = Integer.parseInt(key.substring(bracket + 1, key.length() - 1));
            } catch (NumberFormatException e) {
                return false;
            }
            key = key.substring(0, bracket);
        }
        return llfsmSetExternal(key, index, value);
    }

    static boolean llfsmApplyInputs(List<String> inputs, int round) {
        for (String line : inputs) {
            String['['/][']'/] fields = line.trim().split("\\s+");
            if (fields.length == 0 || fields['['/]0[']'/].isEmpty()) {
                continue;
            }
            int when;
            try {
                when = Integer.parseInt(fields['['/]0[']'/]);
            } catch (NumberFormatException e) {
                continue;
            }
            if (when != round) {
                continue;
            }
            for (int k = 1; k < fields.length; k++) {
                if (!llfsmApplyAssignment(fields['['/]k[']'/])) {
                    System.err.println("invalid input " + fields['['/]k[']'/]);
                    return false;
                }
            }
        }
        return true;
    }

    public static void main(String['['/][']'/] args) {
        System.setOut(new PrintStream(new FileOutputStream(FileDescriptor.out), false, StandardCharsets.UTF_8));
        int maxRounds = args.length > 0 ? Integer.parseInt(args['['/]0[']'/]) : 20;
        List<String> inputs = List.of();
        if (args.length > 1) {
            try {
                inputs = Files.readAllLines(Paths.get(args['['/]1[']'/]), StandardCharsets.UTF_8);
            } catch (IOException e) {
                System.err.println("cannot open " + args['['/]1[']'/]);
                System.exit(1);
            }
        }
        llfsmInitialise();
        System.out.print("arrangement [javaString(a.name)/]\n");
        for (int round = 1; ; round++) {
            if (!llfsmApplyInputs(inputs, round)) {
                System.out.flush();
                System.exit(1);
            }
[for (inst : Instance | a.instances)]
            llfsmInstance_[inst.name/].llfsmRinglet();
            System.out.print("R" + round + " [javaString(inst.name)/] " + llfsmInstance_[inst.name/].llfsmState.llfsmLabel + "\n");
[/for]
            if ([for (inst : Instance | a.instances) separator(' && ')]llfsmInstance_[inst.name/].llfsmState.llfsmAccepting && !llfsmInstance_[inst.name/].llfsmEntered[/for]) {
                System.out.print("halt R" + round + "\n");
                break;
            }
            if (round == maxRounds) {
                break;
            }
        }
        System.out.flush();
    }
}
[/file]
[/template]
